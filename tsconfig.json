{
  "extends": "@subf/config/tsconfig-lib",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@src": ["./src/index.ts"],
      "@src/*": ["./src/*"]
    },
    "types": ["vite/client", "solid-file-router/client", "@testing-library/dom", "node"]
  },
  "include": ["src", "docs", "*.config.ts"],
  "exclude": ["**/dist", "**/node_modules", "docs/routes.d.ts", "src/shared/type-test"]
}
