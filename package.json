{
  "name": "moraine",
  "version": "0.3.4",
  "description": "Comprehensive SolidJS component library with atomic class styling.",
  "keywords": [
    "components",
    "solid",
    "solidjs",
    "tailwindcss",
    "ui",
    "unocss"
  ],
  "homepage": "https://github.com/subframe7536/moraine#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/moraine/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/moraine.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "default": "./dist/index.mjs",
      "type": "./dist/index.d.mts"
    },
    "./package.json": "./package.json",
    "./tw4.css": "./dist/tw4.css",
    "./tw3.css": "./dist/tw3.css",
    "./icon.css": "./dist/icon.css",
    "./unocss": "./dist/unocss.mjs",
    "./tailwind": "./dist/tailwind.mjs",
    "./utils": "./dist/utils.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "bun run docs:dev",
    "docs": "bun run docs:dev",
    "docs:dev": "bun run build && vite serve docs",
    "docs:build": "bun run build && vite build docs",
    "docs:preview": "bun run docs:build && vite preview docs",
    "test": "vitest --run",
    "test:dev": "vitest",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "oxc": "oxlint --fix && oxfmt",
    "qa": "bun run oxc && bun run typecheck",
    "release": "bun run test && bun run qa && bumpp --all",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@formisch/solid": "1.0.0-rc.0",
    "cls-variant": "^1.2.0"
  },
  "devDependencies": {
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@iconify-json/lucide": "^1.2.117",
    "@iconify/tailwind": "1.2.0",
    "@rolldown/pluginutils": "*",
    "@solidjs/router": "^0.16.1",
    "@solidjs/testing-library": "^0.8.10",
    "@subf/config": "^0.2.1",
    "@subf/unocss": "^0.3.0",
    "@tanstack/solid-virtual": "^3.13.33",
    "@testing-library/dom": "*",
    "@types/node": "^24",
    "bumpp": "^11.1.0",
    "jsdom": "^29.1.1",
    "magic-string": "^0.30.21",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "rolldown-plugin-unocss": "^0.1.0",
    "satteri": "^0.9.5",
    "satteri-expressive-code": "^0.1.18",
    "solid-file-router": "^0.6.0",
    "solid-toaster": "^0.1.5",
    "tailwindcss": "^4.3.2",
    "tsdown": "^0.22.7",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vite": "^8.1.4",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@iconify/tailwind": "1.2.0",
    "@subf/unocss": "^0.3.0",
    "solid-js": "^1.9.14",
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@iconify/tailwind": {
      "optional": true
    },
    "@subf/unocss": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "valibot": "1.4.2"
  }
}
