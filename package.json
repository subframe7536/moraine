{
  "name": "moraine",
  "version": "0.11.0",
  "description": "Comprehensive SolidJS component library with atomic class styling.",
  "keywords": [
    "components",
    "solid",
    "solidjs",
    "tailwindcss",
    "ui",
    "unocss"
  ],
  "homepage": "https://github.com/subframe7536/moraine#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/moraine/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/moraine.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.mjs"
    },
    "./data-table": {
      "types": "./dist/data-table.d.mts",
      "solid": "./dist/data-table.jsx",
      "default": "./dist/data-table.mjs"
    },
    "./dnd": {
      "types": "./dist/dnd.d.mts",
      "solid": "./dist/dnd.jsx",
      "default": "./dist/dnd.mjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.mts",
      "default": "./dist/tailwind.mjs"
    },
    "./theme": {
      "types": "./dist/theme.d.mts",
      "default": "./dist/theme.mjs"
    },
    "./unocss": {
      "types": "./dist/unocss.d.mts",
      "default": "./dist/unocss.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    },
    "./virtualizer": {
      "types": "./dist/virtualizer.d.mts",
      "solid": "./dist/virtualizer.jsx",
      "default": "./dist/virtualizer.mjs"
    },
    "./package.json": "./package.json",
    "./icon.css": "./dist/icon.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm --filter @moraine/docs dev",
    "docs:build": "pnpm --filter @moraine/docs build",
    "docs:preview": "pnpm --filter @moraine/docs preview",
    "test": "pnpm run test:docs && pnpm run test:lib",
    "test:lib": "pnpm run build && tsrs -p test/types-default/tsconfig.json && tsrs -p test/types-simple/tsconfig.json && vitest run src/ test/ build/",
    "test:docs": "vitest run docs/",
    "lint": "oxlint --fix --max-warnings 0 --report-unused-disable-directives",
    "format": "oxfmt",
    "typecheck": "tsrs --noEmit --fast",
    "oxc": "pnpm run lint && pnpm run format",
    "qa": "pnpm run lint && pnpm run format && pnpm run typecheck",
    "release": "pnpm i && pnpm run test && pnpm run qa && bumpp --all",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@formisch/solid": "^1.3.0",
    "cn": "catalog:"
  },
  "devDependencies": {
    "@dnd-kit/dom": "^0.5.3",
    "@iconify-json/lucide": "catalog:",
    "@iconify/tailwind": "1.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@subf/config": "^0.5.0",
    "@subf/unocss": "catalog:",
    "@tanstack/table-core": "^9.3.1",
    "@tanstack/virtual-core": "^3.19.11",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "bumpp": "^12.3.0",
    "jsdom": "^31.0.1",
    "magic-string": "^1.4.5",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rolldown-plugin-unocss": "^0.1.0",
    "tailwindcss": "catalog:",
    "tsdown": "^0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@dnd-kit/dom": "^0.5.3",
    "@iconify/tailwind": "^1.2.0",
    "@subf/unocss": "catalog:peers",
    "@tanstack/table-core": "^9.3.1",
    "@tanstack/virtual-core": "^3.19.11",
    "solid-js": "catalog:",
    "tailwindcss": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/dom": {
      "optional": true
    },
    "@iconify/tailwind": {
      "optional": true
    },
    "@subf/unocss": {
      "optional": true
    },
    "@tanstack/table-core": {
      "optional": true
    },
    "@tanstack/virtual-core": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.18.0"
}
