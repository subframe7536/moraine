{
  "name": "moraine",
  "version": "0.5.0",
  "description": "Comprehensive SolidJS component library with atomic class styling.",
  "keywords": [
    "components",
    "solid",
    "solidjs",
    "tailwindcss",
    "ui",
    "unocss"
  ],
  "homepage": "https://github.com/subframe7536/moraine#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/moraine/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/moraine.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/*.css"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./icon.css": "./dist/icon.css",
    "./unocss": {
      "types": "./dist/unocss.d.mts",
      "default": "./dist/unocss.mjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.mts",
      "default": "./dist/tailwind.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "solid": "./dist/utils.jsx",
      "default": "./dist/utils.mjs"
    },
    "./virtualizer": {
      "types": "./dist/virtualizer.d.mts",
      "solid": "./dist/virtualizer.jsx",
      "default": "./dist/virtualizer.mjs"
    },
    "./theme": {
      "types": "./dist/theme.d.mts",
      "default": "./dist/theme.mjs"
    },
    "./styles": {
      "types": "./dist/styles.d.mts",
      "default": "./dist/styles.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm --filter @moraine/docs dev",
    "docs:build": "pnpm --filter @moraine/docs build",
    "docs:preview": "pnpm --filter @moraine/docs preview",
    "test": "pnpm run build && vitest --run",
    "test:types": "pnpm run build && tsc -p test/types-default/tsconfig.json && tsc -p test/types-simple/tsconfig.json",
    "test:dev": "vitest",
    "lint": "oxlint --fix --max-warnings 0",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "oxc": "pnpm run lint && pnpm run format",
    "qa": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test:types",
    "release": "pnpm run test && pnpm run qa && bumpp --all",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@formisch/solid": "^1.1.0",
    "cn": "^0.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@iconify/tailwind": "1.2.0",
    "@solidjs/router": "^1.0.0",
    "@solidjs/testing-library": "^0.8.10",
    "@subf/config": "^0.4.0",
    "@subf/unocss": "^0.3.1",
    "@tanstack/virtual-core": "^3.17.8",
    "@types/node": "^24.13.3",
    "bumpp": "^11.1.0",
    "jsdom": "^30.1.1",
    "magic-string": "^1.2.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown-plugin-unocss": "^0.1.0",
    "satteri": "^0.10.5",
    "solid-file-router": "^0.7.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@iconify/tailwind": "1.2.0",
    "@subf/unocss": "^0.3.0",
    "@tanstack/virtual-core": "^3.17.4",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@iconify/tailwind": {
      "optional": true
    },
    "@subf/unocss": {
      "optional": true
    },
    "@tanstack/virtual-core": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.6.0"
}
