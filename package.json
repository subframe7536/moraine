{
  "name": "moraine",
  "version": "0.6.1",
  "description": "Comprehensive SolidJS component library with atomic class styling.",
  "keywords": [
    "components",
    "solid",
    "solidjs",
    "tailwindcss",
    "ui",
    "unocss"
  ],
  "homepage": "https://github.com/subframe7536/moraine#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/moraine/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/moraine.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/*.css"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.mjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.mts",
      "default": "./dist/tailwind.mjs"
    },
    "./theme": {
      "types": "./dist/theme.d.mts",
      "default": "./dist/theme.mjs"
    },
    "./unocss": {
      "types": "./dist/unocss.d.mts",
      "default": "./dist/unocss.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    },
    "./virtualizer": {
      "types": "./dist/virtualizer.d.mts",
      "solid": "./dist/virtualizer.jsx",
      "default": "./dist/virtualizer.mjs"
    },
    "./package.json": "./package.json",
    "./icon.css": "./dist/icon.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm --filter @moraine/docs dev",
    "docs:build": "pnpm --filter @moraine/docs build",
    "docs:preview": "pnpm --filter @moraine/docs preview",
    "test": "pnpm run test:docs && pnpm run test:lib",
    "test:lib": "pnpm run build && tsc -p test/types-default/tsconfig.json && tsc -p test/types-simple/tsconfig.json && vitest run src/ test/",
    "test:docs": "vitest run docs/",
    "lint": "oxlint --fix --max-warnings 0 --report-unused-disable-directives",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "oxc": "pnpm run lint && pnpm run format",
    "qa": "pnpm run lint && pnpm run format && pnpm run typecheck",
    "release": "pnpm i && pnpm run test && pnpm run qa && bumpp --all",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@formisch/solid": "^1.1.0",
    "cn": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:",
    "@iconify/tailwind": "1.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@subf/config": "^0.5.0",
    "@subf/unocss": "catalog:",
    "@tanstack/virtual-core": "^3.17.11",
    "@types/node": "^24.19.0",
    "bumpp": "^11.1.0",
    "jsdom": "^30.1.1",
    "magic-string": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rolldown-plugin-unocss": "^0.1.0",
    "tailwindcss": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@iconify/tailwind": "1.2.0",
    "@subf/unocss": "catalog:peers",
    "@tanstack/virtual-core": "^3.17.4",
    "solid-js": "catalog:",
    "tailwindcss": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@iconify/tailwind": {
      "optional": true
    },
    "@subf/unocss": {
      "optional": true
    },
    "@tanstack/virtual-core": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.6.0"
}
