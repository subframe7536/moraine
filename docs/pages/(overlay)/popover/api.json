{
  "key": "popover",
  "name": "Popover",
  "category": "overlays",
  "kind": "composite",
  "parts": [
    {
      "id": "popover",
      "name": "Popover",
      "access": {
        "kind": "export",
        "name": "Popover",
        "package": "moraine"
      },
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Composed trigger and content primitives."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this Popover instance."
        },
        {
          "name": "closeDelay",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Delay in milliseconds before closing in hover mode.",
          "default": {
            "kind": "literal",
            "value": 100
          }
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Initial open state when uncontrolled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether trigger interactions and content rendering are disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "dismissible",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether outside interaction and Escape dismiss the content.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "forceMount",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether content remains mounted while closed.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier used to derive the content id."
        },
        {
          "name": "modal",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the content traps focus and hides outside content from assistive technology.\nThis is enabled only when Popover.Content composes Popover.Close; otherwise the Popover\nremains non-modal so assistive-technology users retain a dismissal route.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "mode",
          "optional": true,
          "type": {
            "text": "Mode"
          },
          "description": "Interaction mode for triggering the popover.",
          "default": {
            "kind": "literal",
            "value": "click"
          }
        },
        {
          "name": "onClosePrevent",
          "optional": true,
          "type": {
            "text": "() => void"
          },
          "description": "Called when a dismissal attempt is blocked."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": {
            "text": "(open: boolean) => void"
          },
          "description": "Called whenever the open state changes."
        },
        {
          "name": "open",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Controlled open state."
        },
        {
          "name": "openDelay",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Delay in milliseconds before opening in hover mode.",
          "default": {
            "kind": "literal",
            "value": 100
          }
        },
        {
          "name": "placement",
          "optional": true,
          "type": {
            "text": "PopperPlacement"
          },
          "description": "Preferred content placement relative to the trigger.",
          "default": {
            "kind": "literal",
            "value": "bottom"
          }
        },
        {
          "name": "preventScroll",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether body scroll should be locked while the content is present.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this Popover instance."
        }
      ]
    },
    {
      "id": "popover-trigger",
      "name": "Popover.Trigger",
      "access": {
        "kind": "attached",
        "root": "Popover",
        "member": "Trigger"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "button",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": ""
          },
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Trigger label and visual content."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "popover-content",
      "name": "Popover.Content",
      "access": {
        "kind": "attached",
        "root": "Popover",
        "member": "Content"
      },
      "description": "Props for the Popover component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "ariaLabel",
          "optional": true,
          "type": {
            "text": "string"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Body content."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "ContentClasses"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "side",
          "optional": true,
          "type": {
            "text": "'top' | 'right' | 'bottom' | 'left'"
          },
          "description": "Preferred placement relative to the trigger.",
          "default": {
            "kind": "literal",
            "value": "bottom"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "ContentStyles"
          },
          "description": "Family slot style defaults for this instance."
        }
      ]
    },
    {
      "id": "popover-close",
      "name": "Popover.Close",
      "access": {
        "kind": "attached",
        "root": "Popover",
        "member": "Close"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "button",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": "l"
          },
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Trigger label and visual content."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    }
  ],
  "slots": [
    "trigger",
    "content",
    "body"
  ],
  "dataAttributes": [
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-side"
      ]
    }
  ],
  "cssVariables": []
}
