{
  "key": "modal",
  "name": "Modal",
  "category": "overlays",
  "kind": "composite",
  "parts": [
    {
      "id": "modal",
      "name": "Modal",
      "access": {
        "kind": "export",
        "name": "Modal",
        "package": "moraine"
      },
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Composed trigger and content primitives."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this Modal instance."
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Initial open state when uncontrolled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "dismissible",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether outside interaction and Escape should dismiss the shell.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier used to derive the content id."
        },
        {
          "name": "onClosePrevent",
          "optional": true,
          "type": {
            "text": "() => void"
          },
          "description": "Called when a dismissal attempt is blocked."
        },
        {
          "name": "onExitComplete",
          "optional": true,
          "type": {
            "text": "() => void"
          },
          "description": "Called after the modal has fully finished its exit motion."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": {
            "text": "(open: boolean) => void"
          },
          "description": "Called whenever the open state changes."
        },
        {
          "name": "open",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Controlled open state."
        },
        {
          "name": "preventScroll",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether body scroll should be locked while the shell is present.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this Modal instance."
        }
      ]
    },
    {
      "id": "modal-content",
      "name": "Modal.Content",
      "access": {
        "kind": "attached",
        "root": "Modal",
        "member": "Content"
      },
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "ariaDescribedBy",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Id of the element that describes the modal content."
        },
        {
          "name": "ariaLabel",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Accessible name used when no visible label is available."
        },
        {
          "name": "ariaLabelledBy",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Id of the element that labels the modal content."
        },
        {
          "name": "children",
          "optional": false,
          "type": {
            "text": "ComponentOrElement<ContentRenderProps>"
          },
          "description": "Component or element rendered inside the modal content surface."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "trapFocus",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether this surface behaves as a modal dialog: it traps and receives focus,\nhides outside content from assistive technology, and locks body scroll.",
          "default": {
            "kind": "literal",
            "value": true
          }
        }
      ]
    },
    {
      "id": "modal-overlay",
      "name": "Modal.Overlay",
      "access": {
        "kind": "attached",
        "root": "Modal",
        "member": "Overlay"
      },
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Optional elements rendered inside the overlay."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "ref",
          "optional": true,
          "type": {
            "text": "(element: HTMLDivElement | undefined) => void"
          },
          "description": "Receives the mounted overlay element and `undefined` when it unmounts."
        },
        {
          "name": "scrollable",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the overlay should scroll its content."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "modal-trigger",
      "name": "Modal.Trigger",
      "access": {
        "kind": "attached",
        "root": "Modal",
        "member": "Trigger"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "button",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": "T"
          },
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Trigger label and visual content."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "modal-close",
      "name": "Modal.Close",
      "access": {
        "kind": "attached",
        "root": "Modal",
        "member": "Close"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "button",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": "T"
          },
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Trigger label and visual content."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    }
  ],
  "slots": [
    "overlay",
    "content"
  ],
  "dataAttributes": [
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded"
      ]
    },
    {
      "target": "overlay",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-overlay-scroll"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded"
      ]
    }
  ]
}
