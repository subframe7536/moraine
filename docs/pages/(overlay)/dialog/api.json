        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "ContentClasses",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "description",
          "optional": true,
          "type": "JSX.Element",
          "description": "Secondary description displayed below the title."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "ContentStyles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "title",
          "optional": true,
          "type": "JSX.Element",
          "description": "Primary title displayed in the dialog header."
        }
      ]
    },
