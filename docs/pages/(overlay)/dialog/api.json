{
  "key": "dialog",
  "name": "Dialog",
  "kind": "composite",
  "parts": [
    {
      "id": "dialog",
      "name": "Dialog",
      "access": {
        "kind": "export",
        "name": "Dialog"
      },
      "props": [
        {
          "name": "ariaLabel",
          "optional": true,
          "type": "string",
          "description": "Accessible name used when the dialog has no rendered title."
        },
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element",
          "description": "Composed trigger and content primitives."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this Dialog instance."
        },
        {
          "name": "close",
          "optional": true,
          "type": "boolean",
          "description": "Whether to show a close button.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "closeIcon",
          "optional": true,
          "type": "IconT.Name | JSX.Element",
          "description": "Icon name or custom content for the close button.",
          "default": {
            "kind": "literal",
            "value": "icon-close"
          }
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": "boolean",
          "description": "Initial open state when uncontrolled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "dismissible",
          "optional": true,
          "type": "boolean",
          "description": "Whether outside interaction and Escape should dismiss the shell.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "fullscreen",
          "optional": true,
          "type": "boolean | null",
          "description": "Whether the dialog should take up the full viewport.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": "string",
          "description": "Unique identifier used to derive the content id."
        },
        {
          "name": "onClosePrevent",
          "optional": true,
          "type": "() => void",
          "description": "Called when a dismissal attempt is blocked."
        },
        {
          "name": "onExitComplete",
          "optional": true,
          "type": "() => void",
          "description": "Called after the modal has fully finished its exit motion."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": "(open: boolean) => void",
          "description": "Called whenever the open state changes."
        },
        {
          "name": "open",
          "optional": true,
          "type": "boolean",
          "description": "Controlled open state."
        },
        {
          "name": "overlay",
          "optional": true,
          "type": "boolean",
          "description": "Whether to render the overlay element.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "preventScroll",
          "optional": true,
          "type": "boolean",
          "description": "Whether body scroll should be locked while the shell is present.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "scrollable",
          "optional": true,
          "type": "boolean | null",
          "description": "Whether the overlay should scroll the complete dialog panel.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this Dialog instance."
        },
        {
          "name": "trapFocus",
          "optional": true,
          "type": "boolean",
          "description": "Whether the dialog behaves as a modal surface, including focus containment,\noutside-content isolation, and body scroll locking.",
          "default": {
            "kind": "literal",
            "value": true
          }
        }
      ]
    },
    {
      "id": "dialog-trigger",
      "name": "Dialog.Trigger",
      "access": {
        "kind": "attached",
        "root": "Dialog",
        "member": "Trigger"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "defaultElement": "button",
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": "T",
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element",
          "description": "Trigger label and visual content."
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
