{
  "key": "sheet",
  "name": "Sheet",
  "category": "overlays",
  "kind": "composite",
  "parts": [
    {
      "id": "sheet",
      "name": "Sheet",
      "access": {
        "kind": "export",
        "name": "Sheet",
        "package": "moraine"
      },
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Composed trigger and content primitives."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this Sheet instance."
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Initial open state when uncontrolled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "dismissible",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether outside interaction and Escape should dismiss the shell.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier used to derive the content id."
        },
        {
          "name": "onClosePrevent",
          "optional": true,
          "type": {
            "text": "() => void"
          },
          "description": "Called when a dismissal attempt is blocked."
        },
        {
          "name": "onExitComplete",
          "optional": true,
          "type": {
            "text": "() => void"
          },
          "description": "Called after the modal has fully finished its exit motion."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": {
            "text": "(open: boolean) => void"
          },
          "description": "Called whenever the open state changes."
        },
        {
          "name": "open",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Controlled open state."
        },
        {
          "name": "preventScroll",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether body scroll should be locked while the shell is present.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this Sheet instance."
        }
      ]
    },
    {
      "id": "sheet-trigger",
      "name": "Sheet.Trigger",
      "access": {
        "kind": "attached",
        "root": "Sheet",
        "member": "Trigger"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "button",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": ""
          },
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Trigger label and visual content."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "sheet-content",
      "name": "Sheet.Content",
      "access": {
        "kind": "attached",
        "root": "Sheet",
        "member": "Content"
      },
      "description": "Props for the Sheet component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "ariaLabel",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Accessible name used when the sheet has no rendered title."
        },
        {
          "name": "body",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Custom element to render in the scrollable body slot."
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Main content when body is undefined."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "ContentClasses"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "close",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Whether to show a close button, or a custom element to use as one.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "description",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Secondary description displayed below the title."
        },
        {
          "name": "footer",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Custom element to render in the footer slot."
        },
        {
          "name": "header",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Custom element to render in the header slot."
        },
        {
          "name": "inset",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "overlay",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to render the overlay element."
        },
        {
          "name": "side",
          "optional": true,
          "type": {
            "text": "'bottom' | 'left' | 'right' | 'top'"
          },
          "default": {
            "kind": "literal",
            "value": "right"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "ContentStyles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "title",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Primary title displayed in the sheet header."
        },
        {
          "name": "transition",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to enable transition animations.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "trapFocus",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the sheet behaves as a modal surface, including focus containment,\noutside-content isolation, and body scroll locking.",
          "default": {
            "kind": "literal",
            "value": true
          }
        }
      ]
    },
    {
      "id": "sheet-close",
      "name": "Sheet.Close",
      "access": {
        "kind": "attached",
        "root": "Sheet",
        "member": "Close"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "button",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": ""
          },
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Trigger label and visual content."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    }
  ],
  "slots": [
    "trigger",
    "content",
    "overlay",
    "header",
    "title",
    "description",
    "contentClose",
    "body",
    "footer"
  ],
  "dataAttributes": [
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded"
      ]
    },
    {
      "target": "overlay",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-overlay-scroll"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-transition"
      ]
    },
    {
      "target": "body",
      "attributes": [
        "data-header"
      ]
    }
  ]
}
