{
  "key": "tooltip",
  "name": "Tooltip",
  "category": "overlays",
  "kind": "composite",
  "parts": [
    {
      "id": "tooltip",
      "name": "Tooltip",
      "access": {
        "kind": "export",
        "name": "Tooltip",
        "package": "moraine"
      },
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Composed trigger and content primitives."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this Tooltip instance."
        },
        {
          "name": "closeDelay",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Delay in milliseconds before closing after leaving trigger or content.",
          "default": {
            "kind": "literal",
            "value": 200
          }
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Initial open state when uncontrolled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether trigger interactions and content rendering are disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "forceMount",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether content remains mounted while closed.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier used to derive the content id."
        },
        {
          "name": "instantOpenDelay",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Delay in milliseconds to skip the open delay for the next trigger after closing.",
          "default": {
            "kind": "literal",
            "value": 300
          }
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": {
            "text": "(open: boolean) => void"
          },
          "description": "Called whenever the open state changes."
        },
        {
          "name": "open",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Controlled open state."
        },
        {
          "name": "openDelay",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Delay in milliseconds before opening on hover or focus.",
          "default": {
            "kind": "literal",
            "value": 600
          }
        },
        {
          "name": "placement",
          "optional": true,
          "type": {
            "text": "PopperPlacement"
          },
          "description": "Preferred content placement relative to the trigger.",
          "default": {
            "kind": "literal",
            "value": "top"
          }
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this Tooltip instance."
        }
      ]
    },
    {
      "id": "tooltip-trigger",
      "name": "Tooltip.Trigger",
      "access": {
        "kind": "attached",
        "root": "Tooltip",
        "member": "Trigger"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "button",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": "B"
          },
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Trigger label and visual content."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "tooltip-content",
      "name": "Tooltip.Content",
      "access": {
        "kind": "attached",
        "root": "Tooltip",
        "member": "Content"
      },
      "description": "Props for the Tooltip component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Text content when text is undefined."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "ContentClasses"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "invert",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "kbds",
          "optional": true,
          "type": {
            "text": "string[]"
          },
          "description": "Keyboard shortcuts to display next to the text."
        },
        {
          "name": "side",
          "optional": true,
          "type": {
            "text": "'top' | 'right' | 'bottom' | 'left'"
          },
          "description": "Preferred placement relative to the trigger.",
          "default": {
            "kind": "literal",
            "value": "top"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "ContentStyles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "text",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Primary text content or element to display."
        }
      ]
    }
  ],
  "slots": [
    "trigger",
    "content",
    "text",
    "kbds",
    "kbd"
  ],
  "dataAttributes": [
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-instant-motion",
        "data-side"
      ]
    }
  ]
}
