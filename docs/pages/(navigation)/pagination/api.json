{
  "key": "pagination",
  "name": "Pagination",
  "category": "navigation",
  "description": "Props for the Pagination component.",
  "kind": "single",
  "parts": [
    {
      "id": "pagination",
      "name": "Pagination",
      "access": {
        "kind": "export",
        "name": "Pagination",
        "package": "moraine"
      },
      "description": "Props for the Pagination component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "nav",
        "polymorphic": false
      },
      "props": [
        {
          "name": "activeVariant",
          "optional": true,
          "type": {
            "text": "'default' | 'secondary' | 'outline' | 'ghost' | 'link' | 'destructive'"
          },
          "default": {
            "kind": "literal",
            "value": "outline"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "controlAs",
          "optional": true,
          "type": {
            "text": "ValidComponent"
          },
          "description": "Component used to render previous and next controls."
        },
        {
          "name": "controlVariant",
          "optional": true,
          "type": {
            "text": "'default' | 'secondary' | 'outline' | 'ghost' | 'link' | 'destructive'"
          },
          "default": {
            "kind": "literal",
            "value": "ghost"
          }
        },
        {
          "name": "defaultPage",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Initial page number when uncontrolled.",
          "default": {
            "kind": "literal",
            "value": 1
          }
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the pagination is disabled."
        },
        {
          "name": "ellipsisIcon",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon name for the ellipsis indicator.",
          "default": {
            "kind": "literal",
            "value": "icon-ellipsis"
          }
        },
        {
          "name": "itemAs",
          "optional": true,
          "type": {
            "text": "ValidComponent"
          },
          "description": "Component used to render numbered page items."
        },
        {
          "name": "itemsPerPage",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Number of items to display per page.",
          "default": {
            "kind": "literal",
            "value": 10
          }
        },
        {
          "name": "nextIcon",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon name for the next button.",
          "default": {
            "kind": "literal",
            "value": "icon-chevron-right"
          }
        },
        {
          "name": "nextText",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Text to display in the next button."
        },
        {
          "name": "onPageChange",
          "optional": true,
          "type": {
            "text": "(page: number) => void"
          },
          "description": "Callback triggered when the page changes."
        },
        {
          "name": "page",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Controlled current page number (1-indexed)."
        },
        {
          "name": "prevIcon",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon name for the previous button.",
          "default": {
            "kind": "literal",
            "value": "icon-chevron-left"
          }
        },
        {
          "name": "prevText",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Text to display in the previous button."
        },
        {
          "name": "ref",
          "optional": true,
          "type": {
            "text": "Ref<HTMLElement>"
          },
          "description": "Ref forwarded to the root `<nav>` element."
        },
        {
          "name": "showControls",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to show previous and next control buttons.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "siblingCount",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Number of page buttons to show on either side of the current page.\nFinite integer values are clamped between 0 and 100.",
          "default": {
            "kind": "literal",
            "value": 2
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "to",
          "optional": true,
          "type": {
            "text": "(page: number) => string | undefined"
          },
          "description": "Function to generate a destination URL for a given page number.\nWithout a custom component, enabled pagination controls with a destination render as anchors."
        },
        {
          "name": "total",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Total number of items across all pages.",
          "default": {
            "kind": "literal",
            "value": 0
          }
        },
        {
          "name": "variant",
          "optional": true,
          "type": {
            "text": "'default' | 'secondary' | 'outline' | 'ghost' | 'link' | 'destructive'"
          },
          "default": {
            "kind": "literal",
            "value": "ghost"
          }
        }
      ]
    }
  ],
  "slots": [
    "root",
    "list",
    "listItem",
    "item",
    "prev",
    "next",
    "ellipsis",
    "controlLabel"
  ],
  "dataAttributes": [
    {
      "target": "prev",
      "attributes": [
        "data-disabled",
        "data-loading",
        "data-text"
      ]
    },
    {
      "target": "item",
      "attributes": [
        "data-current",
        "data-disabled",
        "data-loading"
      ]
    },
    {
      "target": "next",
      "attributes": [
        "data-disabled",
        "data-loading",
        "data-text"
      ]
    },
    {
      "target": "ellipsis",
      "attributes": [
        "data-ellipsis"
      ]
    }
  ]
}
