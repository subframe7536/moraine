{
  "key": "sidebar-frame",
  "name": "SidebarFrame",
  "kind": "composite",
  "parts": [
    {
      "id": "sidebar-frame",
      "name": "SidebarFrame",
      "access": {
        "kind": "export",
        "name": "SidebarFrame"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element"
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "isMobile",
          "optional": true,
          "type": "boolean",
          "description": "Controlled mobile mode. When omitted, `matchMedia` determines the value."
        },
        {
          "name": "scrollThreshold",
          "optional": true,
          "type": "number",
          "description": "Main scroll offset that changes `scrolled` to true.",
          "default": {
            "kind": "literal",
            "value": 60
          }
        },
        {
          "name": "side",
          "optional": true,
          "type": "'left' | 'right'",
          "description": "Side occupied by the sidebar.",
          "default": {
            "kind": "literal",
            "value": "left"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "variant",
          "optional": true,
          "type": "'default' | 'floating' | 'inset'",
          "default": {
            "kind": "literal",
            "value": "default"
          }
        }
      ]
    },
    {
      "id": "sidebar-frame-sidebar",
      "name": "SidebarFrame.Sidebar",
      "access": {
        "kind": "attached",
        "root": "SidebarFrame",
        "member": "Sidebar"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "ariaLabel",
          "optional": true,
          "type": "string",
          "description": "Accessible name for the mobile navigation Sheet. Native aria-label takes precedence;\ntitle is used when neither native aria-label nor this prop is provided.",
          "default": {
            "kind": "literal",
            "value": "Sidebar navigation"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element"
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "sidebar-frame-sidebar-header",
      "name": "SidebarFrame.SidebarHeader",
      "access": {
        "kind": "attached",
        "root": "SidebarFrame",
        "member": "SidebarHeader"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element"
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "sidebar-frame-sidebar-body",
      "name": "SidebarFrame.SidebarBody",
      "access": {
        "kind": "attached",
        "root": "SidebarFrame",
        "member": "SidebarBody"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element"
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "sidebar-frame-sidebar-footer",
      "name": "SidebarFrame.SidebarFooter",
      "access": {
        "kind": "attached",
        "root": "SidebarFrame",
        "member": "SidebarFooter"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element"
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "sidebar-frame-main",
      "name": "SidebarFrame.Main",
      "access": {
        "kind": "attached",
        "root": "SidebarFrame",
        "member": "Main"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element"
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "sidebar-frame-trigger",
      "name": "SidebarFrame.Trigger",
      "access": {
        "kind": "attached",
        "root": "SidebarFrame",
        "member": "Trigger"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "defaultElement": "button",
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": "T",
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element",
          "description": "Trigger label and visual content."
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    }
  ],
  "slots": [
    "root",
    "sidebar",
    "sidebarHeader",
    "sidebarBody",
    "sidebarFooter",
    "main"
  ],
  "dataAttributes": [
    {
      "target": "sidebar",
      "attributes": [
        "data-closed",
        "data-mobile"
      ]
    },
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-open"
      ]
    }
  ]
}
