{
  "key": "tabs",
  "name": "Tabs",
  "category": "navigation",
  "description": "Props for the Tabs component.",
  "kind": "single",
  "parts": [
    {
      "id": "tabs",
      "name": "Tabs",
      "access": {
        "kind": "export",
        "name": "Tabs",
        "package": "moraine"
      },
      "description": "Props for the Tabs component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "activationMode",
          "optional": true,
          "type": {
            "text": "'automatic' | 'manual'"
          },
          "description": "Whether keyboard navigation activates the tab immediately or waits for confirmation.",
          "default": {
            "kind": "literal",
            "value": "automatic"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Default active tab value for uncontrolled usage."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the tab list is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier for the tabs root element."
        },
        {
          "name": "items",
          "optional": true,
          "type": {
            "text": "Item[]"
          },
          "description": "Array of tabs to display."
        },
        {
          "name": "loop",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether arrow-key navigation wraps from the ends.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "onChange",
          "optional": true,
          "type": {
            "text": "(value: string) => void"
          },
          "description": "Callback when the active tab changes."
        },
        {
          "name": "orientation",
          "optional": true,
          "type": {
            "text": "'horizontal' | 'vertical'"
          },
          "default": {
            "kind": "literal",
            "value": "horizontal"
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "value",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Controlled active tab value."
        },
        {
          "name": "variant",
          "optional": true,
          "type": {
            "text": "'pill' | 'link'"
          },
          "default": {
            "kind": "literal",
            "value": "pill"
          }
        }
      ]
    }
  ],
  "item": {
    "name": "Item",
    "description": "An individual tab in the tabs component.",
    "props": [
      {
        "name": "content",
        "optional": true,
        "type": {
          "text": "JSX.Element"
        },
        "description": "Content to display when the tab is active."
      },
      {
        "name": "disabled",
        "optional": true,
        "type": {
          "text": "boolean"
        },
        "description": "Whether the tab is disabled.",
        "default": {
          "kind": "literal",
          "value": false
        }
      },
      {
        "name": "icon",
        "optional": true,
        "type": {
          "text": "IconT.Name"
        },
        "description": "Icon to display next to the label."
      },
      {
        "name": "label",
        "optional": true,
        "type": {
          "text": "JSX.Element"
        },
        "description": "Label to display on the tab trigger."
      },
      {
        "name": "value",
        "optional": true,
        "type": {
          "text": "string"
        },
        "description": "Unique value for the tab.",
        "default": {
          "kind": "expression",
          "text": "index of the item"
        }
      }
    ]
  },
  "slots": [
    "root",
    "list",
    "indicator",
    "trigger",
    "leading",
    "label",
    "trailing",
    "content"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-disabled"
      ]
    },
    {
      "target": "trigger",
      "attributes": [
        "data-disabled",
        "data-highlighted",
        "data-selected"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-selected"
      ]
    }
  ]
}
