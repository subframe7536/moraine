{
  "key": "stepper",
  "name": "Stepper",
  "category": "navigation",
  "description": "Props for the Stepper component.",
  "kind": "single",
  "parts": [
    {
      "id": "stepper",
      "name": "Stepper",
      "access": {
        "kind": "export",
        "name": "Stepper",
        "package": "moraine"
      },
      "description": "Props for the Stepper component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "activationMode",
          "optional": true,
          "type": {
            "text": "'automatic' | 'manual'"
          },
          "description": "Whether keyboard activation happens immediately or only after confirmation.",
          "default": {
            "kind": "literal",
            "value": "automatic"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "clickable",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether steps are clickable for navigation.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": {
            "text": "Value"
          },
          "description": "Default active step value for uncontrolled usage."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the entire stepper is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier for the stepper root element."
        },
        {
          "name": "items",
          "optional": true,
          "type": {
            "text": "Item[]"
          },
          "description": "Array of steps to display."
        },
        {
          "name": "linear",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to enforce linear navigation (must complete steps in order).",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "loop",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether keyboard navigation loops around when reaching the ends.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "onChange",
          "optional": true,
          "type": {
            "text": "(value: Value) => void"
          },
          "description": "Callback when the active step changes."
        },
        {
          "name": "orientation",
          "optional": true,
          "type": {
            "text": "'horizontal' | 'vertical'"
          },
          "default": {
            "kind": "literal",
            "value": "horizontal"
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "value",
          "optional": true,
          "type": {
            "text": "Value"
          },
          "description": "Controlled active step value."
        }
      ]
    }
  ],
  "item": {
    "name": "Item",
    "description": "An individual step in the stepper.",
    "props": [
      {
        "name": "class",
        "optional": true,
        "type": {
          "text": "string"
        },
        "description": "Additional class name for the step item."
      },
      {
        "name": "content",
        "optional": true,
        "type": {
          "text": "JSX.Element"
        },
        "description": "Content to display when the step is active."
      },
      {
        "name": "description",
        "optional": true,
        "type": {
          "text": "JSX.Element"
        },
        "description": "Secondary description of the step."
      },
      {
        "name": "disabled",
        "optional": true,
        "type": {
          "text": "boolean"
        },
        "description": "Whether the step is disabled.",
        "default": {
          "kind": "literal",
          "value": false
        }
      },
      {
        "name": "icon",
        "optional": true,
        "type": {
          "text": "IconT.Name"
        },
        "description": "Icon to display in the step indicator.",
        "default": {
          "kind": "expression",
          "text": "index + 1"
        }
      },
      {
        "name": "title",
        "optional": true,
        "type": {
          "text": "JSX.Element"
        },
        "description": "Title of the step."
      },
      {
        "name": "value",
        "optional": true,
        "type": {
          "text": "Value"
        },
        "description": "Unique value for the step.",
        "default": {
          "kind": "expression",
          "text": "index of the item"
        }
      }
    ]
  },
  "slots": [
    "root",
    "header",
    "item",
    "trigger",
    "indicator",
    "icon",
    "separator",
    "wrapper",
    "title",
    "description",
    "content"
  ],
  "dataAttributes": [
    {
      "target": "item",
      "attributes": [
        "data-disabled",
        "data-state"
      ]
    },
    {
      "target": "trigger",
      "attributes": [
        "data-clickable",
        "data-selected",
        "data-state"
      ]
    },
    {
      "target": "indicator",
      "attributes": [
        "data-state"
      ]
    },
    {
      "target": "separator",
      "attributes": [
        "data-disabled",
        "data-state"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-selected"
      ]
    }
  ]
}
