{
  "$schema": "https://moraine.subf.dev/component-api.schema.json",
  "key": "badge",
  "name": "Badge",
  "description": "Props for the Badge component.",
  "kind": "single",
  "parts": [
    {
      "id": "badge",
      "name": "Badge",
      "access": {
        "kind": "export",
        "name": "Badge"
      },
      "description": "Props for the Badge component.",
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'span'"
        }
      ],
      "defaultElement": "span",
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": "T",
          "description": "Root element or component.",
          "default": {
            "kind": "literal",
            "value": "span"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element",
          "description": "Label content, used when `label` is not set. Empty content renders no label element."
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "label",
          "optional": true,
          "type": "JSX.Element",
          "description": "Label content. When set (not `undefined` or `null`), it is rendered instead of `children`."
        },
        {
          "name": "leading",
          "optional": true,
          "type": "IconT.Name",
          "description": "Name of an icon rendered before the label. A badge with exactly one icon (`leading` or\n`trailing`) and no label renders as a square icon badge."
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "description": "Visual size of the component.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "tone",
          "optional": true,
          "type": "Tone",
          "description": "Color tone of the component.",
          "default": {
            "kind": "literal",
            "value": "neutral"
          }
        },
        {
          "name": "trailing",
          "optional": true,
          "type": "IconT.Name",
          "description": "Name of an icon rendered after the label. A badge with exactly one icon (`leading` or\n`trailing`) and no label renders as a square icon badge."
        },
        {
          "name": "variant",
          "optional": true,
          "type": "'solid' | 'soft' | 'subtle' | 'outline'",
          "description": "Visual treatment of the component.",
          "default": {
            "kind": "literal",
            "value": "soft"
          }
        }
      ]
    }
  ],
  "slots": [
    "root",
    "leading",
    "label",
    "trailing"
  ],
  "dataAttributes": []
}
