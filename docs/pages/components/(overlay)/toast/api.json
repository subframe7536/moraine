{
  "$schema": "https://moraine.subf.dev/component-api.schema.json",
  "key": "toast",
  "name": "Toast",
  "description": "Props for the Toast host component.",
  "kind": "single",
  "parts": [
    {
      "id": "toast",
      "name": "Toast",
      "access": {
        "kind": "export",
        "name": "Toast"
      },
      "description": "Props for the Toast host component.",
      "defaultElement": "section",
      "props": [
        {
          "name": "align",
          "optional": true,
          "type": "'start' | 'center' | 'end'",
          "description": "Horizontal alignment of the stack.",
          "default": {
            "kind": "literal",
            "value": "end"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "close",
          "optional": true,
          "type": "boolean",
          "description": "Whether toasts show a close button.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "duration",
          "optional": true,
          "type": "number",
          "description": "Default duration before auto-close in milliseconds.",
          "default": {
            "kind": "literal",
            "value": 4000
          }
        },
        {
          "name": "expand",
          "optional": true,
          "type": "boolean",
          "description": "Whether to expand the stacked toast list by default.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "gap",
          "optional": true,
          "type": "number",
          "description": "Gap between toasts in pixels when expanded.",
          "default": {
            "kind": "literal",
            "value": 14
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": "string",
          "description": "Match toasts targeting a specific Toast host identifier."
        },
        {
          "name": "invert",
          "optional": true,
          "type": "boolean",
          "description": "Whether to invert colors (e.g. dark toast on light theme).",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "itemRender",
          "optional": true,
          "type": "Component<ItemRenderProps>",
          "description": "Renders the inner content of every toast on this host that was not opened with\n`Toast.custom`. Receives the instance context and the resolved call options."
        },
        {
          "name": "large",
          "optional": true,
          "type": "boolean",
          "description": "Whether to use large multi-line layout.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "placement",
          "optional": true,
          "type": "'top' | 'bottom'",
          "description": "Vertical stack placement on the viewport.",
          "default": {
            "kind": "literal",
            "value": "bottom"
          }
        },
        {
          "name": "preventDuplicate",
          "optional": true,
          "type": "boolean",
          "description": "Prevent duplicate toasts with matching content.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "progress",
          "optional": true,
          "type": "boolean",
          "description": "Whether to show the remaining duration progress bar.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "type",
          "optional": true,
          "type": "'default' | 'success' | 'warning' | 'error' | 'info' | 'loading'",
          "description": "Visual status variant.",
          "default": {
            "kind": "literal",
            "value": "default"
          }
        },
        {
          "name": "visibleToasts",
          "optional": true,
          "type": "number",
          "description": "Max number of simultaneously visible toasts in a stack.",
          "default": {
            "kind": "literal",
            "value": 3
          }
        }
      ]
    }
  ],
  "slots": [
    "root",
    "list",
    "item",
    "wrapper",
    "title",
    "description",
    "icon",
    "actions",
    "close",
    "action",
    "cancel",
    "progress"
  ],
  "dataAttributes": [
    {
      "target": "item",
      "attributes": [
        "data-behind",
        "data-bump",
        "data-closed",
        "data-expanded",
        "data-front",
        "data-limited",
        "data-swipe-out",
        "data-swiping"
      ]
    },
    {
      "target": "list",
      "attributes": [
        "data-expanded"
      ]
    }
  ]
}
