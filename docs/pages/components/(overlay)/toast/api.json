{
  "key": "toast",
  "name": "Toast",
  "description": "Props for the Toast host component.",
  "kind": "single",
  "parts": [
    {
      "id": "toast",
      "name": "Toast",
      "access": {
        "kind": "export",
        "name": "Toast"
      },
      "description": "Props for the Toast host component.",
      "defaultElement": "section",
      "props": [
        {
          "name": "align",
          "optional": true,
          "type": "'start' | 'center' | 'end'",
          "description": "Viewport alignment relative to the placement side.",
          "default": {
            "kind": "literal",
            "value": "end"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Class overrides for component slots."
        },
        {
          "name": "close",
          "optional": true,
          "type": "Action | JSX.Element",
          "description": "Close button configuration or custom JSX element. When truthy, enables closing.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "duration",
          "optional": true,
          "type": "number",
          "description": "Default duration before auto-close in milliseconds.",
          "default": {
            "kind": "literal",
            "value": 4000
          }
        },
        {
          "name": "expand",
          "optional": true,
          "type": "boolean",
          "description": "Whether to expand the stacked toast list by default.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "gap",
          "optional": true,
          "type": "number",
          "description": "Gap between toasts in pixels when expanded.",
          "default": {
            "kind": "literal",
            "value": 14
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": "string",
          "description": "Match toasts targeting a specific Toast host identifier."
        },
        {
          "name": "invert",
          "optional": true,
          "type": "boolean",
          "description": "Invert toast colors.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "placement",
          "optional": true,
          "type": "Placement",
          "description": "Viewport placement on the screen.",
          "default": {
            "kind": "literal",
            "value": "bottom"
          }
        },
        {
          "name": "preventDuplicate",
          "optional": true,
          "type": "PreventDuplicate",
          "description": "Prevent duplicate toasts with matching content.\nCan be a boolean or a custom predicate comparing candidate against the front toast.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "showProgress",
          "optional": true,
          "type": "boolean",
          "description": "Whether to show the remaining duration progress bar.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "store",
          "optional": true,
          "type": "ToastStore",
          "description": "Isolated store rendered by this host. Defaults to the shared `Toast.*` store."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Style overrides for component slots."
        },
        {
          "name": "visibleToasts",
          "optional": true,
          "type": "number",
          "description": "Max number of simultaneously visible toasts in a stack.",
          "default": {
            "kind": "literal",
            "value": 3
          }
        }
      ]
    }
  ],
  "slots": [
    "root",
    "list",
    "item",
    "wrapper",
    "title",
    "description",
    "icon",
    "close",
    "action",
    "cancel",
    "progress"
  ],
  "dataAttributes": [
    {
      "target": "item",
      "attributes": [
        "data-behind",
        "data-bump",
        "data-expanded",
        "data-front",
        "data-limited",
        "data-swipe-out",
        "data-swiping"
      ]
    },
    {
      "target": "list",
      "attributes": [
        "data-expanded"
      ]
    }
  ]
}
