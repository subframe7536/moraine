{
  "key": "sidebar-frame",
  "name": "SidebarFrame",
  "kind": "composite",
  "parts": [
    {
      "id": "sidebar-frame",
      "name": "SidebarFrame",
      "access": {
        "kind": "export",
        "name": "SidebarFrame"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "breakpoint",
          "optional": true,
          "type": "number",
          "description": "Max viewport width in pixels that counts as mobile.\nUsed as `(max-width: ${breakpoint}px)` when `isMobile` is omitted.",
          "default": {
            "kind": "literal",
            "value": 768
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element"
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": "boolean",
          "description": "Default open state on desktop.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "isMobile",
          "optional": true,
          "type": "boolean",
          "description": "Controlled mobile mode. When omitted, `matchMedia` uses `breakpoint`."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": "(open: boolean) => void",
          "description": "Callback invoked when desktop open state changes."
        },
        {
          "name": "open",
          "optional": true,
          "type": "boolean",
          "description": "Controlled open state on desktop."
        },
        {
          "name": "scrollThreshold",
          "optional": true,
          "type": "number",
          "description": "Main scroll offset that changes `scrolled` to true.",
          "default": {
            "kind": "literal",
            "value": 60
          }
        },
        {
          "name": "side",
          "optional": true,
          "type": "'left' | 'right'",
          "description": "Side occupied by the sidebar.",
          "default": {
            "kind": "literal",
            "value": "left"
          }
        },
        {
          "name": "sidebarId",
          "optional": true,
          "type": "string",
          "description": "Stable identifier used for associating Trigger `aria-controls` with Sidebar."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "variant",
          "optional": true,
          "type": "'default' | 'floating' | 'inset'",
          "default": {
            "kind": "literal",
            "value": "default"
          }
        }
      ]
    },
