{
  "$schema": "https://moraine.subf.dev/component-api.schema.json",
  "key": "progress",
  "name": "Progress",
  "kind": "single",
  "parts": [
    {
      "id": "progress",
      "name": "Progress",
      "access": {
        "kind": "export",
        "name": "Progress"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "animation",
          "optional": true,
          "type": "'carousel' | 'reverse' | 'swing' | 'elastic'",
          "description": "Visual animation of the component.",
          "default": {
            "kind": "literal",
            "value": "carousel"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "label",
          "optional": true,
          "type": "JSX.Element",
          "description": "Content for the label slot."
        },
        {
          "name": "max",
          "optional": true,
          "type": "number",
          "description": "The maximum value of the progress bar.",
          "default": {
            "kind": "literal",
            "value": 100
          }
        },
        {
          "name": "orientation",
          "optional": true,
          "type": "'horizontal' | 'vertical'",
          "description": "Visual layout direction.",
          "default": {
            "kind": "literal",
            "value": "horizontal"
          }
        },
        {
          "name": "showValue",
          "optional": true,
          "type": "boolean",
          "description": "Whether to show the value slot for determinate progress.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "description": "Visual size of the component.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "translations",
          "optional": true,
          "type": "Translations",
          "description": "Localized message overrides for this progress instance."
        },
        {
          "name": "value",
          "optional": true,
          "type": "number",
          "description": "The current value of the progress bar. If undefined, it is indeterminate.",
          "default": {
            "kind": "expression",
            "text": "undefined"
          }
        },
        {
          "name": "valueLabel",
          "optional": true,
          "type": "(params: { value: number; min: number; max: number }) => string",
          "description": "Callback that supplies `aria-valuetext` for a determinate value."
        },
        {
          "name": "valueRender",
          "optional": true,
          "type": "JSX.Element | Component<ValueRenderProps>",
          "description": "Content or render function for the value slot.\nDeterminate progress shows this instead of the percentage."
        }
      ]
    }
  ],
  "slots": [
    "root",
    "label",
    "value",
    "track",
    "indicator"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-indeterminate",
        "data-progress"
      ]
    },
    {
      "target": "indicator",
      "attributes": [
        "data-indeterminate",
        "data-progress"
      ]
    }
  ]
}
