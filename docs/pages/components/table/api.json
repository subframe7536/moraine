{
  "$schema": "https://moraine.subf.dev/component-api.schema.json",
  "key": "table",
  "name": "Table",
  "description": "Props for Table.",
  "kind": "composite",
  "parts": [
    {
      "id": "table",
      "name": "Table",
      "access": {
        "kind": "export",
        "name": "Table"
      },
      "description": "Props for Table.",
      "defaultElement": "table",
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element",
          "description": "Table parts and direct content."
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "containerRef",
          "optional": true,
          "type": "Ref<HTMLDivElement>",
          "description": "Ref forwarded to the scroll container element."
        },
        {
          "name": "hoverEffect",
          "optional": true,
          "type": "boolean",
          "description": "Whether rows highlight on hover.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "showBorder",
          "optional": true,
          "type": "'row' | 'col' | 'both'",
          "description": "Which divider borders are displayed.",
          "default": {
            "kind": "literal",
            "value": "row"
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "description": "Density of table rows and cells.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "striped",
          "optional": true,
          "type": "boolean",
          "description": "Whether rows display alternating background colors.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        }
      ]
    },
    {
      "id": "table-header",
      "name": "Table.Header",
      "access": {
        "kind": "attached",
        "root": "Table",
