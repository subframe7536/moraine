{
  "$schema": "https://moraine.subf.dev/component-api.schema.json",
  "key": "sidebar",
  "name": "Sidebar",
  "kind": "composite",
  "parts": [
    {
      "id": "sidebar",
      "name": "Sidebar",
      "access": {
        "kind": "export",
        "name": "Sidebar"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "breakpoint",
          "optional": true,
          "type": "number",
          "description": "Max viewport width in pixels that counts as mobile.\nUsed as `(max-width: ${breakpoint}px)` when `isMobile` is omitted.",
          "default": {
            "kind": "literal",
            "value": 768
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element"
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": "boolean",
          "description": "Default open state on desktop.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "isMobile",
          "optional": true,
          "type": "boolean",
          "description": "Controlled mobile mode. When omitted, `matchMedia` uses `breakpoint`."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": "(open: boolean) => void",
          "description": "Callback invoked when desktop open state changes."
        },
        {
          "name": "open",
          "optional": true,
          "type": "boolean",
          "description": "Controlled open state on desktop."
        },
        {
          "name": "panelId",
          "optional": true,
          "type": "string",
          "description": "Stable identifier used for associating Trigger `aria-controls` with Panel."
        },
        {
          "name": "scrollThreshold",
          "optional": true,
          "type": "number",
          "description": "Inset scroll offset that changes `scrolled` to true.",
          "default": {
            "kind": "literal",
            "value": 60
          }
        },
        {
          "name": "side",
          "optional": true,
          "type": "'left' | 'right'",
          "default": {
            "kind": "literal",
            "value": "left"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "translations",
          "optional": true,
          "type": "Translations",
          "description": "Localized message overrides for this sidebar instance."
        },
        {
          "name": "variant",
          "optional": true,
          "type": "'default' | 'floating' | 'inset'",
          "default": {
            "kind": "literal",
            "value": "default"
          }
        }
      ]
    },
    {
      "id": "sidebar-panel",
      "name": "Sidebar.Panel",
      "access": {
        "kind": "attached",
        "root": "Sidebar",
        "member": "Panel"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'aside'"
        }
      ],
      "defaultElement": "aside",
      "props": [
        {
          "name": "aria-label",
          "optional": true,
          "type": "string",
          "description": "Accessible name for the mobile navigation Sheet. Native aria-label takes precedence;\ntitle is used when neither native aria-label nor this prop is provided.\nLocalized via MoraineProvider messages when omitted. English default is `Sidebar navigation`."
        },
        {
          "name": "as",
          "optional": true,
          "type": "T",
          "default": {
            "kind": "literal",
            "value": "aside"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element"
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
