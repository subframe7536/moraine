          "name": "children",
          "optional": true,
          "type": "JSX.Element",
          "description": "Controls placed over the end of the enclosing `MenuItem`'s first row, such as a dropdown\nmenu trigger. The `MenuButton` stays highlighted while the pointer is over these controls."
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
