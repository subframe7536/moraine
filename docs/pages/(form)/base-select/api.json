{
  "key": "base-select",
  "name": "BaseSelect",
  "kind": "composite",
  "parts": [
    {
      "id": "base-select",
      "name": "BaseSelect",
      "access": {
        "kind": "export",
        "name": "BaseSelect"
      },
      "generics": [
        {
          "name": "TItem",
          "constraint": "Item",
          "default": "Item"
        }
      ],
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element",
          "description": "Composed trigger and popup parts."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this BaseSelect instance."
        },
        {
          "name": "closeOnSelect",
          "optional": true,
          "type": "boolean",
          "description": "Close after selection. Defaults to true for single, false for multiple."
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": "boolean",
          "description": "Initial popup state.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": "readonly TItem['value'][]",
          "description": "Initial selection.",
          "default": {
            "kind": "expression",
            "text": "[]"
          }
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": "string",
          "description": "The ID of the input element."
        },
        {
          "name": "isItemDisabled",
          "optional": true,
          "type": "(item: TItem, values: readonly TItem['value'][]) => boolean",
          "description": "Additional disabled policy evaluated against the current selection."
        },
        {
          "name": "items",
          "optional": true,
          "type": "readonly TItem[]",
          "description": "Current flat navigation collection."
        },
        {
          "name": "itemToLabelString",
          "optional": true,
          "type": "(item: TItem) => string",
          "description": "Machine-readable text for matching; does not change visual labels."
        },
        {
          "name": "loop",
          "optional": true,
          "type": "boolean",
          "description": "Whether arrow-key navigation wraps from the ends.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "multiple",
          "optional": true,
          "type": "boolean",
          "description": "Whether selecting an item toggles multiple values."
        },
        {
          "name": "name",
          "optional": true,
          "type": "string",
          "description": "The name of the input element, used for form submission."
        },
        {
          "name": "onChange",
          "optional": true,
          "type": "(value: TItem['value'][]) => void",
          "description": "Called when selection changes."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": "(open: boolean) => void",
          "description": "Called when popup state changes."
        },
        {
          "name": "onReset",
          "optional": true,
          "type": "() => void",
          "description": "Post-reset notification after an unprevented native form reset."
        },
        {
          "name": "open",
          "optional": true,
          "type": "boolean",
          "description": "Controlled popup state."
        },
        {
          "name": "readOnly",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is read-only.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "required",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "serializeValue",
          "optional": true,
          "type": "(value: TItem['value']) => string | undefined",
          "description": "Native form value; return undefined to omit a selected value from submission."
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "description": "Popup and item size.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this BaseSelect instance."
        },
        {
          "name": "value",
          "optional": true,
          "type": "readonly TItem['value'][]",
          "description": "Controlled selection. Single mode uses at most the first value."
        }
      ]
    },
    {
      "id": "base-select-control",
      "name": "BaseSelect.Control",
      "access": {
        "kind": "attached",
        "root": "BaseSelect",
        "member": "Control"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "base-select-trigger",
      "name": "BaseSelect.Trigger",
      "access": {
        "kind": "attached",
        "root": "BaseSelect",
        "member": "Trigger"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        },
        {
          "name": "TItem",
          "constraint": "Item",
          "default": "Item"
        }
      ],
      "defaultElement": "button",
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": "T",
          "description": "Element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "button"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element | ((state: TriggerRenderProps<TItem>) => JSX.Element)",
          "description": "Label or reactive presentation function."
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "description": "Whether this trigger is disabled."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "base-select-content",
      "name": "BaseSelect.Content",
      "access": {
        "kind": "attached",
        "root": "BaseSelect",
        "member": "Content"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "gutter",
          "optional": true,
          "type": "number",
          "description": "Gap between anchor and popup.",
          "default": {
            "kind": "literal",
            "value": 0
          }
        },
        {
          "name": "onExitComplete",
          "optional": true,
          "type": "() => void",
          "description": "Called once after an open popup completes its exit."
        },
        {
          "name": "overflowPadding",
          "optional": true,
          "type": "number",
          "description": "Viewport collision padding.",
          "default": {
            "kind": "literal",
            "value": 4
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "base-select-listbox",
      "name": "BaseSelect.Listbox",
      "access": {
        "kind": "attached",
        "root": "BaseSelect",
        "member": "Listbox"
      },
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "string"
        },
        {
          "name": "style",
          "optional": true,
          "type": "JSX.CSSProperties"
        }
      ]
    },
    {
      "id": "base-select-item",
      "name": "BaseSelect.Item",
      "access": {
        "kind": "attached",
        "root": "BaseSelect",
        "member": "Item"
      },
      "generics": [
        {
          "name": "TItem",
          "constraint": "Item",
          "default": "Item"
        }
      ],
      "defaultElement": "div",
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": "JSX.Element | ((state: ItemRenderProps<TItem>) => JSX.Element)",
          "description": "Visual content or reactive row presentation."
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "description": "Whether this item cannot be selected."
        },
        {
          "name": "label",
          "optional": false,
          "type": "JSX.Element",
          "description": "Visual label."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "value",
          "optional": false,
          "type": "TItem['value']",
          "description": "Unique selection and form value."
        }
      ]
    },
    {
      "id": "base-select-group",
      "name": "BaseSelect.Group",
      "access": {
        "kind": "attached",
        "root": "BaseSelect",
        "member": "Group"
      },
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "string"
        },
        {
          "name": "style",
          "optional": true,
          "type": "JSX.CSSProperties"
        }
      ]
    },
    {
      "id": "base-select-group-label",
      "name": "BaseSelect.GroupLabel",
      "access": {
        "kind": "attached",
        "root": "BaseSelect",
        "member": "GroupLabel"
      },
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "string"
        },
        {
          "name": "style",
          "optional": true,
          "type": "JSX.CSSProperties"
        }
      ]
    },
    {
      "id": "base-select-separator",
      "name": "BaseSelect.Separator",
      "access": {
        "kind": "attached",
        "root": "BaseSelect",
        "member": "Separator"
      },
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "string"
        },
        {
          "name": "style",
          "optional": true,
          "type": "JSX.CSSProperties"
        }
      ]
    },
    {
      "id": "base-select-empty",
      "name": "BaseSelect.Empty",
      "access": {
        "kind": "attached",
        "root": "BaseSelect",
        "member": "Empty"
      },
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "string"
        },
        {
          "name": "style",
          "optional": true,
          "type": "JSX.CSSProperties"
        }
      ]
    }
  ],
  "item": {
    "generics": [
      {
        "name": "TValue",
        "constraint": "string | number",
        "default": "string | number"
      }
    ],
    "props": [
      {
        "name": "disabled",
        "optional": true,
        "type": "boolean",
        "description": "Whether this item cannot be selected."
      },
      {
        "name": "label",
        "optional": false,
        "type": "JSX.Element",
        "description": "Visual label."
      },
      {
        "name": "value",
        "optional": false,
        "type": "TValue",
        "description": "Unique selection and form value."
      }
    ]
  },
  "slots": [
    "control",
    "trigger",
    "content",
    "listbox",
    "item",
    "group",
    "groupLabel",
    "separator",
    "empty"
  ],
  "dataAttributes": [
    {
      "target": "control",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded",
        "data-invalid",
        "data-readonly",
        "data-required"
      ]
    },
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded",
        "data-invalid"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-side"
      ]
    },
    {
      "target": "item",
      "attributes": [
        "data-disabled",
        "data-highlighted",
        "data-selected"
      ]
    }
  ]
}
