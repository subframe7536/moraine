          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is read-only.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "required",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
