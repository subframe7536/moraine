{
  "key": "slider",
  "name": "Slider",
  "category": "forms",
  "description": "Props for the Slider component.",
  "kind": "single",
  "parts": [
    {
      "id": "slider",
      "name": "Slider",
      "access": {
        "kind": "export",
        "name": "Slider",
        "package": "moraine"
      },
      "description": "Props for the Slider component.",
      "generics": [
        {
          "name": "TValue",
          "default": "Value"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "allowThumbCrossing",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether dragging can continue across another thumb when there is no minimum gap.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": {
            "text": "TValue"
          },
          "description": "The default value of the input (uncontrolled)."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "divider",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to show visual step dividers on the track, only applicable when `step` is defined and greater than 0.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "The ID of the input element."
        },
        {
          "name": "inputRef",
          "optional": true,
          "type": {
            "text": "Ref<HTMLInputElement>"
          },
          "description": "Optional inner input element ref."
        },
        {
          "name": "inverted",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Reverses value movement along the track.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "max",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Maximum value of the slider.",
          "default": {
            "kind": "literal",
            "value": 100
          }
        },
        {
          "name": "min",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Minimum value of the slider.",
          "default": {
            "kind": "literal",
            "value": 0
          }
        },
        {
          "name": "minStepsBetweenThumbs",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Minimum steps required between thumbs in a multi-thumb slider.",
          "default": {
            "kind": "literal",
            "value": 0
          }
        },
        {
          "name": "name",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "The name of the input element, used for form submission."
        },
        {
          "name": "onChange",
          "optional": true,
          "type": {
            "text": "(value: TValue) => void"
          },
          "description": "Callback when the slider selection change is committed."
        },
        {
          "name": "onValueChange",
          "optional": true,
          "type": {
            "text": "(value: TValue) => void"
          },
          "description": "Callback when the slider selection changes during interaction."
        },
        {
          "name": "orientation",
          "optional": true,
          "type": {
            "text": "'horizontal' | 'vertical'"
          },
          "default": {
            "kind": "literal",
            "value": "horizontal"
          }
        },
        {
          "name": "readOnly",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is read-only.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "required",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "step",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Step increment between values.\nWhen omitted, pointer movement is continuous."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "value",
          "optional": true,
          "type": {
            "text": "TValue"
          },
          "description": "The current value of the input (controlled)."
        },
        {
          "name": "variant",
          "optional": true,
          "type": {
            "text": "'default' | 'bold'"
          },
          "default": {
            "kind": "literal",
            "value": "default"
          }
        }
      ]
    }
  ],
  "slots": [
    "root",
    "track",
    "range",
    "divider",
    "thumb"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-disabled",
        "data-dragging",
        "data-invalid",
        "data-inverted",
        "data-multiple",
        "data-readonly",
        "data-required"
      ]
    },
    {
      "target": "range",
      "attributes": [
        "data-inverted",
        "data-multiple"
      ]
    },
    {
      "target": "thumb",
      "attributes": [
        "data-disabled",
        "data-dragging",
        "data-invalid",
        "data-inverted",
        "data-readonly",
        "data-required"
      ]
    }
  ]
}
