{
  "key": "combobox",
  "name": "Combobox",
  "kind": "single",
  "parts": [
    {
      "id": "combobox",
      "name": "Combobox",
      "access": {
        "kind": "export",
        "name": "Combobox"
      },
      "generics": [
        {
          "name": "TItem",
          "constraint": "string | Item",
          "default": "string | Item"
        }
      ],
      "defaultElement": "div",
      "props": [
        {
          "name": "allowClear",
          "optional": true,
          "type": "boolean",
          "description": "Show a clear action when a value or query exists."
        },
        {
          "name": "autocomplete",
          "optional": true,
          "type": "JSX.InputHTMLAttributes<HTMLInputElement>['autocomplete']",
          "description": "The autocomplete attribute for the search input.",
          "default": {
            "kind": "literal",
            "value": "off"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "closeIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Clear icon.",
          "default": {
            "kind": "literal",
            "value": "icon-close"
          }
        },
        {
          "name": "closeOnSelect",
          "optional": true,
          "type": "boolean",
          "description": "Close after selection. Defaults to true for single, false for multiple."
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": "boolean",
          "description": "Initial popup state.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "defaultSearchValue",
          "optional": true,
          "type": "string",
          "description": "Initial search text.",
          "default": {
            "kind": "literal",
            "value": ""
          }
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": "NormalizedItem<TItem>['value'] | null",
          "description": "The default value of the input (uncontrolled)."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "emptyRender",
          "optional": true,
          "type": "ComponentOrElement<EmptyRenderProps<TItem>>",
          "description": "Custom renderer for the filtered empty state."
        },
        {
          "name": "filterItem",
          "optional": true,
          "type": "boolean | 'startsWith' | 'endsWith' | 'contains' | ((query: string, item: NormalizedItem<TItem>) => boolean)",
          "description": "Filtering strategy or predicate receiving the raw item.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "gutter",
          "optional": true,
          "type": "number",
          "description": "Anchor gap in pixels.",
          "default": {
            "kind": "literal",
            "value": 0
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": "string",
          "description": "The ID of the input element."
        },
        {
          "name": "inputRef",
          "optional": true,
          "type": "Ref<HTMLInputElement>",
          "description": "Optional inner input element ref."
        },
        {
          "name": "isItemDisabled",
          "optional": true,
          "type": "(item: NormalizedItem<TItem>, values: readonly NormalizedItem<TItem>['value'][]) => boolean",
          "description": "Additional disabled policy evaluated against the current selection."
        },
        {
          "name": "itemProps",
          "optional": true,
          "type": "(state: BaseSelectT.ItemRenderProps<NormalizedItem<TItem>>) => ElementProps<HTMLDivElement> | undefined",
          "description": "Additional row attributes."
        },
        {
          "name": "itemRender",
          "optional": true,
          "type": "ComponentOrElement<BaseSelectT.ItemRenderProps<NormalizedItem<TItem>>>",
          "description": "Custom item presentation."
        },
        {
          "name": "items",
          "optional": true,
          "type": "Entry<TItem>[]",
          "typeDetails": "(string | {\n  /** Unique selection and form value. */\n  value: string | number;\n  /** Visual label. */\n  label: JSX.Element;\n  /** Whether this item cannot be selected. */\n  disabled?: boolean;\n  /** Leading item icon. */\n  icon?: IconT.Name;\n  /** Secondary item description. */\n  description?: JSX.Element;\n} | {\n  /** Structural group discriminator. */\n  type: 'group';\n  label: JSX.Element;\n  items: (string | {\n    /** Unique selection and form value. */\n    value: string | number;\n    /** Visual label. */\n    label: JSX.Element;\n    /** Whether this item cannot be selected. */\n    disabled?: boolean;\n    /** Leading item icon. */\n    icon?: IconT.Name;\n    /** Secondary item description. */\n    description?: JSX.Element;\n  })[];\n})[]",
          "description": "String shorthand or object items, optionally grouped. Item values must be unique."
        },
        {
          "name": "itemToLabelString",
          "optional": true,
          "type": "(item: NormalizedItem<TItem>) => string",
          "description": "Machine-readable text for matching; does not change visual labels."
        },
        {
          "name": "leadingIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Leading icon."
        },
        {
          "name": "listboxProps",
          "optional": true,
          "type": "ElementProps<HTMLDivElement>",
          "description": "Additional listbox attributes."
        },
        {
          "name": "loading",
          "optional": true,
          "type": "boolean",
          "description": "Whether the control is loading."
        },
        {
          "name": "loadingIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Loading icon.",
          "default": {
            "kind": "literal",
            "value": "icon-loading"
          }
        },
        {
          "name": "name",
          "optional": true,
          "type": "string",
          "description": "The name of the input element, used for form submission."
        },
        {
          "name": "onChange",
          "optional": true,
          "type": "(value: NoInfer<NormalizedItem<TItem>['value'] | null>) => void",
          "description": "Called when the committed selection changes."
        },
        {
          "name": "onClear",
          "optional": true,
          "type": "() => void",
          "description": "Called once when clear is triggered."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": "(open: boolean) => void",
          "description": "Called when popup state changes."
        },
        {
          "name": "onReset",
          "optional": true,
          "type": "() => void",
          "description": "Post-reset notification after an unprevented native form reset."
        },
        {
          "name": "onScrollBottom",
          "optional": true,
          "type": "() => void",
          "description": "Called once when scrolling reaches the bottom."
        },
        {
          "name": "onSearch",
          "optional": true,
          "type": "(value: string) => void",
          "description": "Called when search text changes."
        },
        {
          "name": "open",
          "optional": true,
          "type": "boolean",
          "description": "Controlled popup state."
        },
        {
          "name": "openOnControlClick",
          "optional": true,
          "type": "boolean",
          "description": "Whether ordinary control/input pointer clicks open the popup.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "overflowPadding",
          "optional": true,
          "type": "number",
          "description": "Collision padding in pixels.",
          "default": {
            "kind": "literal",
            "value": 4
          }
        },
        {
          "name": "placeholder",
          "optional": true,
          "type": "string",
          "description": "Placeholder shown when there is no selected value or query."
        },
        {
          "name": "readOnly",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is read-only.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "required",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "scrollBottomThreshold",
          "optional": true,
          "type": "number",
          "description": "Bottom threshold in pixels.",
          "default": {
            "kind": "literal",
            "value": 20
          }
        },
        {
          "name": "scrollToItem",
          "optional": true,
          "type": "(item: NormalizedItem<TItem>, entryIndex: number) => void",
          "description": "Scroll a highlighted item to its logical entry index."
        },
        {
          "name": "searchMaxLength",
          "optional": true,
          "type": "number",
          "description": "Maximum committed search length."
        },
        {
          "name": "searchValue",
          "optional": true,
          "type": "string",
          "description": "Controlled search text."
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "description": "Visual size of the component.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "trailingIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Popup toggle icon.",
          "default": {
            "kind": "literal",
            "value": "icon-chevron-down"
          }
        },
        {
          "name": "value",
          "optional": true,
          "type": "NormalizedItem<TItem>['value'] | null",
          "description": "The current value of the input (controlled)."
        },
        {
          "name": "variant",
          "optional": true,
          "type": "'outline' | 'subtle' | 'ghost' | 'none'",
          "description": "Visual treatment of the component.",
          "default": {
            "kind": "literal",
            "value": "outline"
          }
        },
        {
          "name": "virtualRender",
          "optional": true,
          "type": "Component<SelectVirtualRenderProps<NormalizedItem<TItem>>>",
          "description": "Virtual rendering adapter."
        }
      ]
    }
  ],
  "item": {
    "generics": [
      {
        "name": "Val",
        "constraint": "string | number",
        "default": "string | number"
      }
    ],
    "props": [
      {
        "name": "description",
        "optional": true,
        "type": "JSX.Element",
        "description": "Secondary item description."
      },
      {
        "name": "disabled",
        "optional": true,
        "type": "boolean",
        "description": "Whether this item cannot be selected."
      },
      {
        "name": "icon",
        "optional": true,
        "type": "IconT.Name",
        "description": "Leading item icon."
      },
      {
        "name": "label",
        "optional": false,
        "type": "JSX.Element",
        "description": "Visual label."
      },
      {
        "name": "value",
        "optional": false,
        "type": "Val",
        "description": "Unique selection and form value."
      }
    ]
  },
  "slots": [
    "control",
    "content",
    "listbox",
    "item",
    "group",
    "groupLabel",
    "separator",
    "empty",
    "leading",
    "clear",
    "itemLeading",
    "itemWrapper",
    "itemLabel",
    "itemDescription",
    "itemIndicator",
    "input",
    "trigger"
  ],
  "dataAttributes": [
    {
      "target": "control",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-editable",
        "data-expanded",
        "data-invalid",
        "data-readonly",
        "data-required"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-side"
      ]
    },
    {
      "target": "item",
      "attributes": [
        "data-disabled",
        "data-highlighted",
        "data-selected"
      ]
    },
    {
      "target": "trigger",
      "attributes": [
        "data-loading"
      ]
    }
  ]
}
