{
  "key": "select",
  "name": "Select",
  "kind": "single",
  "parts": [
    {
      "id": "select",
      "name": "Select",
      "access": {
        "kind": "export",
        "name": "Select"
      },
      "generics": [
        {
          "name": "TItem",
          "constraint": "Item",
          "default": "Item"
        }
      ],
      "defaultElement": "div",
      "props": [
        {
          "name": "allowClear",
          "optional": true,
          "type": "boolean",
          "description": "Show a pointer clear affordance when a value is selected."
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "closeIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Icon used by the clear affordance."
        },
        {
          "name": "closeOnSelect",
          "optional": true,
          "type": "boolean",
          "description": "Close after selection. Defaults to true for single, false for multiple."
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": "boolean",
          "description": "Initial popup state.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": "TItem['value'] | null",
          "description": "The default value of the input (uncontrolled)."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "emptyRender",
          "optional": true,
          "type": "ComponentOrElement<EmptyRenderProps<TItem>>",
          "description": "Custom renderer for the empty state when current filtered result has no matches."
        },
        {
          "name": "gutter",
          "optional": true,
          "type": "number",
          "description": "Anchor gap in pixels.",
          "default": {
            "kind": "literal",
            "value": 0
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": "string",
          "description": "The ID of the input element."
        },
        {
          "name": "isItemDisabled",
          "optional": true,
          "type": "(item: TItem, values: readonly TItem['value'][]) => boolean",
          "description": "Additional disabled policy evaluated against the current selection."
        },
        {
          "name": "itemProps",
          "optional": true,
          "type": "(state: BaseSelectT.ItemRenderProps<TItem>) => ElementProps<HTMLDivElement> | undefined",
          "description": "Additional row attributes."
        },
        {
          "name": "itemRender",
          "optional": true,
          "type": "ComponentOrElement<BaseSelectT.ItemRenderProps<TItem>>",
          "description": "Custom item presentation."
        },
        {
          "name": "items",
          "optional": true,
          "type": "Entry<TItem>[]",
          "description": "Source items, optionally grouped. Item values must be unique within the collection."
        },
        {
          "name": "itemToLabelString",
          "optional": true,
          "type": "(item: TItem) => string",
          "description": "Machine-readable text for matching; does not change visual labels."
        },
        {
          "name": "leadingIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Icon shown before the input/value area."
        },
        {
          "name": "listboxProps",
          "optional": true,
          "type": "ElementProps<HTMLDivElement>",
          "description": "Additional listbox attributes."
        },
        {
          "name": "loading",
          "optional": true,
          "type": "boolean",
          "description": "Whether the select is in a loading state."
        },
        {
          "name": "loadingIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Icon shown during loading state.",
          "default": {
            "kind": "literal",
            "value": "icon-loading"
          }
        },
        {
          "name": "name",
          "optional": true,
          "type": "string",
          "description": "The name of the input element, used for form submission."
        },
        {
          "name": "onChange",
          "optional": true,
          "type": "(value: NoInfer<TItem['value'] | null>) => void",
          "description": "Called when the selection changes."
        },
        {
          "name": "onClear",
          "optional": true,
          "type": "() => void",
          "description": "Called when clear is triggered."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": "(open: boolean) => void",
          "description": "Called when popup state changes."
        },
        {
          "name": "onReset",
          "optional": true,
          "type": "() => void",
          "description": "Post-reset notification after an unprevented native form reset."
        },
        {
          "name": "onScrollBottom",
          "optional": true,
          "type": "() => void",
          "description": "Called once when scrolling reaches the bottom."
        },
        {
          "name": "open",
          "optional": true,
          "type": "boolean",
          "description": "Controlled popup state."
        },
        {
          "name": "overflowPadding",
          "optional": true,
          "type": "number",
          "description": "Collision padding in pixels.",
          "default": {
            "kind": "literal",
            "value": 4
          }
        },
        {
          "name": "placeholder",
          "optional": true,
          "type": "string",
          "description": "Placeholder text shown when no value is selected.",
          "default": {
            "kind": "literal",
            "value": ""
          }
        },
        {
          "name": "readOnly",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is read-only.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "required",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "scrollBottomThreshold",
          "optional": true,
          "type": "number",
          "description": "Bottom threshold in pixels.",
          "default": {
            "kind": "literal",
            "value": 20
          }
        },
        {
          "name": "scrollToItem",
          "optional": true,
          "type": "(item: TItem, entryIndex: number) => void",
          "description": "Scroll a highlighted item to its logical entry index."
        },
        {
          "name": "size",
          "optional": true,
          "type": "ComponentSize",
          "description": "Visual size of the component.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "trailingIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Icon for the dropdown trigger.",
          "default": {
            "kind": "literal",
            "value": "icon-chevron-down"
          }
        },
        {
          "name": "value",
          "optional": true,
          "type": "TItem['value'] | null",
          "description": "The current value of the input (controlled)."
        },
        {
          "name": "variant",
          "optional": true,
          "type": "TextControlVariant",
          "description": "Visual treatment of the component.",
          "default": {
            "kind": "literal",
            "value": "outline"
          }
        },
        {
          "name": "virtualRender",
          "optional": true,
          "type": "Component<SelectVirtualRenderProps<TItem>>",
          "description": "Virtual rendering adapter."
        }
      ]
    }
  ],
  "item": {
    "generics": [
      {
        "name": "Val",
        "constraint": "string | number",
        "default": "string | number"
      }
    ],
    "props": [
      {
        "name": "description",
        "optional": true,
        "type": "JSX.Element",
        "description": "Secondary item description."
      },
      {
        "name": "disabled",
        "optional": true,
        "type": "boolean",
        "description": "Whether this item cannot be selected."
      },
      {
        "name": "icon",
        "optional": true,
        "type": "IconT.Name",
        "description": "Leading item icon."
      },
      {
        "name": "label",
        "optional": false,
        "type": "JSX.Element",
        "description": "Visual label."
      },
      {
        "name": "value",
        "optional": false,
        "type": "Val",
        "description": "Unique selection and form value."
      }
    ]
  },
  "slots": [
    "control",
    "content",
    "listbox",
    "item",
    "group",
    "groupLabel",
    "separator",
    "empty",
    "leading",
    "clear",
    "itemLeading",
    "itemLabel",
    "itemDescription",
    "itemTrailing",
    "trigger",
    "trailing",
    "value"
  ],
  "dataAttributes": [
    {
      "target": "control",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded",
        "data-invalid",
        "data-readonly",
        "data-required"
      ]
    },
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded",
        "data-invalid"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-side"
      ]
    },
    {
      "target": "item",
      "attributes": [
        "data-disabled",
        "data-highlighted",
        "data-selected"
      ]
    },
    {
      "target": "trailing",
      "attributes": [
        "data-loading"
      ]
    },
    {
      "target": "value",
      "attributes": [
        "data-placeholder"
      ]
    }
  ]
}
