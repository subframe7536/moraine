{
  "key": "select",
  "name": "Select",
  "category": "forms",
  "kind": "single",
  "parts": [
    {
      "id": "select",
      "name": "Select",
      "access": {
        "kind": "export",
        "name": "Select",
        "package": "moraine"
      },
      "generics": [
        {
          "name": "TItem",
          "constraint": "Item",
          "default": "Item"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "allowClear",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Show a pointer clear affordance when a value is selected."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "closeIcon",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon used by the clear affordance."
        },
        {
          "name": "closeOnSelect",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Close after selection. Defaults to true for single, false for multiple."
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Initial popup state.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": {
            "text": "TItem['value'] | null"
          },
          "description": "The default value of the input (uncontrolled)."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "emptyRender",
          "optional": true,
          "type": {
            "text": "ComponentOrElement<EmptyRenderProps<TItem>>"
          },
          "description": "Custom renderer for the empty state when current filtered result has no matches."
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "The ID of the input element."
        },
        {
          "name": "isItemDisabled",
          "optional": true,
          "type": {
            "text": "(item: TItem, values: readonly TItem['value'][]) => boolean"
          },
          "description": "Additional disabled policy evaluated against the current selection."
        },
        {
          "name": "items",
          "optional": true,
          "type": {
            "text": "Entry<TItem>[]"
          },
          "description": "Source items, optionally grouped. Item values must be unique within the collection."
        },
        {
          "name": "itemToLabelString",
          "optional": true,
          "type": {
            "text": "(item: TItem) => string"
          },
          "description": "Machine-readable text for matching; does not change visual labels."
        },
        {
          "name": "leadingIcon",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon shown before the input/value area."
        },
        {
          "name": "loading",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the select is in a loading state."
        },
        {
          "name": "loadingIcon",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon shown during loading state.",
          "default": {
            "kind": "literal",
            "value": "icon-loading"
          }
        },
        {
          "name": "name",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "The name of the input element, used for form submission."
        },
        {
          "name": "onChange",
          "optional": true,
          "type": {
            "text": "(value: NoInfer<TItem['value'] | null>) => void"
          },
          "description": "Called when the selection changes."
        },
        {
          "name": "onClear",
          "optional": true,
          "type": {
            "text": "() => void"
          },
          "description": "Called when clear is triggered."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": {
            "text": "(open: boolean) => void"
          },
          "description": "Called when popup state changes."
        },
        {
          "name": "onReset",
          "optional": true,
          "type": {
            "text": "() => void"
          },
          "description": "Post-reset notification after an unprevented native form reset."
        },
        {
          "name": "open",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Controlled popup state."
        },
        {
          "name": "placeholder",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Placeholder text shown when no value is selected.",
          "default": {
            "kind": "literal",
            "value": ""
          }
        },
        {
          "name": "readOnly",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is read-only.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "required",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "trailingIcon",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon for the dropdown trigger.",
          "default": {
            "kind": "literal",
            "value": "icon-chevron-down"
          }
        },
        {
          "name": "value",
          "optional": true,
          "type": {
            "text": "TItem['value'] | null"
          },
          "description": "The current value of the input (controlled)."
        },
        {
          "name": "variant",
          "optional": true,
          "type": {
            "text": "'outline' | 'subtle' | 'ghost' | 'none'"
          },
          "default": {
            "kind": "literal",
            "value": "outline"
          }
        }
      ]
    }
  ],
  "item": {
    "name": "Item",
    "generics": [
      {
        "name": "Val",
        "constraint": "string | number",
        "default": "string | number"
      }
    ],
    "props": [
      {
        "name": "description",
        "optional": true,
        "type": {
          "text": "JSX.Element"
        },
        "description": "Secondary item description."
      },
      {
        "name": "disabled",
        "optional": true,
        "type": {
          "text": "boolean"
        },
        "description": "Whether this item cannot be selected."
      },
      {
        "name": "icon",
        "optional": true,
        "type": {
          "text": "IconT.Name"
        },
        "description": "Leading item icon."
      },
      {
        "name": "label",
        "optional": false,
        "type": {
          "text": "JSX.Element"
        },
        "description": "Visual label."
      },
      {
        "name": "value",
        "optional": false,
        "type": {
          "text": "Val"
        },
        "description": "Unique selection and form value."
      }
    ]
  },
  "slots": [
    "control",
    "content",
    "listbox",
    "item",
    "group",
    "groupLabel",
    "separator",
    "empty",
    "leading",
    "clear",
    "itemLeading",
    "itemLabel",
    "itemDescription",
    "itemTrailing",
    "trigger",
    "trailing",
    "value"
  ],
  "dataAttributes": [
    {
      "target": "control",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded",
        "data-invalid",
        "data-readonly",
        "data-required"
      ]
    },
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded",
        "data-invalid"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-side"
      ]
    },
    {
      "target": "item",
      "attributes": [
        "data-disabled",
        "data-highlighted",
        "data-selected"
      ]
    },
    {
      "target": "trailing",
      "attributes": [
        "data-loading"
      ]
    },
    {
      "target": "value",
      "attributes": [
        "data-placeholder"
      ]
    }
  ]
}
