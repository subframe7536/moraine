{
  "key": "checkbox",
  "name": "Checkbox",
  "description": "Props for the Checkbox component.",
  "kind": "single",
  "parts": [
    {
      "id": "checkbox",
      "name": "Checkbox",
      "access": {
        "kind": "export",
        "name": "Checkbox"
      },
      "description": "Props for the Checkbox component.",
      "generics": [
        {
          "name": "TTrue",
          "default": "boolean"
        },
        {
          "name": "TFalse",
          "default": "boolean"
        }
      ],
      "defaultElement": "div",
      "props": [
        {
          "name": "checked",
          "optional": true,
          "type": "TTrue | TFalse | 'indeterminate'",
          "description": "Whether the checkbox is checked (controlled)."
        },
        {
          "name": "checkedIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Icon to show when checked.",
          "default": {
            "kind": "literal",
            "value": "icon-check"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "defaultChecked",
          "optional": true,
          "type": "boolean | 'indeterminate'",
          "description": "Whether the checkbox is checked by default (uncontrolled).",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "description",
          "optional": true,
          "type": "JSX.Element",
          "description": "Description text for the checkbox."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "falseValue",
          "optional": true,
          "type": "TFalse",
          "description": "Value to use when the checkbox is unchecked.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "fieldBind",
          "optional": true,
          "type": "boolean",
          "description": "Whether to bind the checkbox value to the parent Field.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": "string",
          "description": "The ID of the input element."
        },
        {
          "name": "indeterminate",
          "optional": true,
          "type": "boolean",
          "description": "Whether the checkbox is in an indeterminate state.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "indeterminateIcon",
          "optional": true,
          "type": "IconT.Name",
          "description": "Icon to show when indeterminate.",
          "default": {
            "kind": "literal",
            "value": "icon-minus"
          }
        },
        {
          "name": "indicator",
          "optional": true,
          "type": "'start' | 'end' | 'hidden'",
          "description": "Placement of the selection indicator.",
          "default": {
            "kind": "literal",
            "value": "start"
          }
        },
        {
          "name": "inputRef",
          "optional": true,
          "type": "Ref<HTMLInputElement>",
          "description": "Native input element ref."
        },
        {
          "name": "label",
          "optional": true,
          "type": "JSX.Element",
          "description": "Label for the checkbox."
        },
        {
          "name": "name",
          "optional": true,
          "type": "string",
          "description": "The name of the input element, used for form submission."
        },
        {
          "name": "onChange",
          "optional": true,
          "type": "(value: TTrue | TFalse) => void",
          "description": "Callback when the checked state changes."
        },
        {
          "name": "onPointerDown",
          "optional": true,
          "type": "JSX.EventHandlerUnion<HTMLButtonElement, PointerEvent>",
          "description": "Pointer down handler for the checkbox control."
        },
        {
          "name": "readOnly",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is read-only.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "required",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "description": "Visual size of the component.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "trueValue",
          "optional": true,
          "type": "TTrue",
          "description": "Value to use when the checkbox is checked.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "value",
          "optional": true,
          "type": "string",
          "description": "Native value submitted when the checkbox is checked.",
          "default": {
            "kind": "literal",
            "value": "on"
          }
        },
        {
          "name": "variant",
          "optional": true,
          "type": "'card' | 'list'",
          "description": "Visual treatment of the component."
        }
      ]
    }
  ],
  "slots": [
    "root",
    "control",
    "indicator",
    "icon",
    "wrapper",
    "container",
    "label",
    "description"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-checked",
        "data-disabled",
        "data-indeterminate",
        "data-invalid",
        "data-readonly",
        "data-required",
        "data-unchecked"
      ]
    },
    {
      "target": "control",
      "attributes": [
        "data-checked",
        "data-disabled",
        "data-indeterminate",
        "data-invalid",
        "data-readonly",
        "data-required",
        "data-unchecked"
      ]
    },
    {
      "target": "indicator",
      "attributes": [
        "data-checked",
        "data-disabled",
        "data-indeterminate"
      ]
    },
    {
      "target": "label",
      "attributes": [
        "data-required"
      ]
    }
  ]
}
