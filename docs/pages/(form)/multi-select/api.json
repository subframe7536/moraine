{
  "key": "multi-select",
  "name": "MultiSelect",
  "category": "forms",
  "kind": "single",
  "sourcePath": "src/forms/multi-select/multi-select.tsx",
  "parts": [
    {
      "id": "multi-select",
      "name": "MultiSelect",
      "access": {
        "kind": "export",
        "name": "MultiSelect",
        "package": "moraine"
      },
      "sourcePath": "src/forms/multi-select/multi-select.tsx",
      "generics": [
        {
          "name": "TItem",
          "constraint": "Item",
          "default": "Item"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
