          "optional": true,
          "type": {
            "text": "string[]"
          },
          "description": "Strings that commit completed input tokens through `createItem` or an exact source match.\nDuplicate separators are ignored and overlapping separators prefer the longest match.",
          "default": {
            "kind": "expression",
            "text": "[',']"
          },
          "group": "behavior"
        },
        {
          "name": "filterItem",
          "optional": true,
          "type": {
            "text": " | boolean | 'startsWith' | 'endsWith' | 'contains' | ((query: string, item: TItem) => boolean)"
          },
          "description": "Filtering strategy or predicate receiving the raw item.",
          "default": {
            "kind": "literal",
            "value": true
          },
          "group": "data",
          "traits": [
            "callback"
          ]
        },
        {
          "name": "isItemDisabled",
          "optional": true,
          "type": {
            "text": "(item: TItem, values: readonly TItem['value'][]) => boolean"
          },
          "description": "Additional disabled policy evaluated against the current selection.",
          "group": "data",
          "traits": [
            "callback"
          ]
        },
        {
          "name": "items",
          "optional": true,
          "type": {
            "text": "Entry<TItem>[]"
          },
          "description": "Source items, optionally grouped. Item values must be unique within the collection.",
          "group": "data"
        },
        {
          "name": "itemToLabelString",
          "optional": true,
          "type": {
            "text": "(item: TItem) => string"
          },
          "description": "Machine-readable text for matching; does not change visual labels.",
          "group": "data",
          "traits": [
            "callback"
          ]
        },
