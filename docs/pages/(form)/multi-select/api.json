          "name": "allowClear",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Show a clear button when a value is selected.",
          "default": {
            "kind": "literal",
            "value": false
          },
          "group": "behavior"
        },
        {
          "name": "createItem",
          "optional": true,
          "type": {
            "text": "(input: string) => TItem"
          },
          "description": "Factory used for unmatched free-text creation.\nProviding it also enables the editable search input.",
          "group": "behavior",
          "traits": [
            "callback"
          ]
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          },
          "group": "behavior"
        },
        {
          "name": "gutter",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Anchor gap in pixels.",
          "default": {
            "kind": "literal",
            "value": 0
          },
          "group": "behavior",
          "traits": [
            "positioning"
          ]
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "The ID of the input element.",
          "group": "behavior"
        },
        {
          "name": "inputRef",
          "optional": true,
          "type": {
            "text": "Ref<HTMLInputElement>"
          },
          "description": "Optional editable inner input element ref. Not assigned in non-editable mode.",
          "group": "behavior"
        },
        {
          "name": "itemProps",
          "optional": true,
          "type": {
            "text": "(state: BaseSelectT.ItemRenderProps<TItem>) => ElementProps<HTMLDivElement> | undefined"
          },
          "description": "Additional row attributes.",
          "group": "behavior",
          "traits": [
            "callback"
          ]
        },
        {
          "name": "listboxProps",
          "optional": true,
          "type": {
            "text": "ElementProps<HTMLDivElement>"
          },
          "description": "Additional listbox attributes.",
          "group": "behavior"
        },
        {
          "name": "loading",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the select is in a loading state.",
          "group": "behavior"
        },
        {
          "name": "maxCount",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Maximum number of selected values (multiple/tags).",
          "group": "behavior"
        },
        {
          "name": "maxTagCount",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Maximum visible tags before collapsing the remainder into a +N summary.",
          "group": "behavior"
        },
        {
          "name": "onClear",
          "optional": true,
          "type": {
            "text": "() => void"
          },
          "description": "Called when clear is triggered.",
          "group": "behavior",
          "traits": [
            "callback"
          ]
        },
        {
          "name": "onScrollBottom",
          "optional": true,
          "type": {
            "text": "() => void"
          },
          "description": "Called once when scrolling reaches the bottom.",
          "group": "behavior",
          "traits": [
            "callback"
          ]
        },
        {
          "name": "openOnControlClick",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether ordinary control/input pointer clicks open the popup.\nDefaults to `false` when editable (`search` or `createItem` enabled),\nor `true` when non-editable.",
          "group": "behavior"
        },
        {
          "name": "overflowPadding",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Collision padding in pixels.",
          "default": {
            "kind": "literal",
            "value": 4
          },
          "group": "behavior",
          "traits": [
            "positioning"
          ]
        },
        {
          "name": "placeholder",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Placeholder text shown when no value is selected.",
          "default": {
            "kind": "literal",
            "value": ""
          },
          "group": "behavior"
        },
        {
          "name": "scrollBottomThreshold",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Bottom threshold in pixels.",
          "default": {
            "kind": "literal",
            "value": 20
          },
          "group": "behavior"
        },
        {
          "name": "scrollToItem",
          "optional": true,
          "type": {
            "text": "(item: TItem, entryIndex: number) => void"
          },
          "description": "Scroll a highlighted item to its logical entry index.",
          "group": "behavior",
          "traits": [
            "callback"
          ]
        },
        {
          "name": "search",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the collection can be filtered through the editable input.",
          "default": {
            "kind": "literal",
            "value": false
          },
          "group": "behavior"
        },
        {
          "name": "searchMaxLength",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Maximum committed search length.",
          "group": "behavior"
        },
