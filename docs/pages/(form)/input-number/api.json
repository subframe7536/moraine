{
  "key": "input-number",
  "name": "InputNumber",
  "category": "forms",
  "description": "Props for the InputNumber component.",
  "kind": "single",
  "parts": [
    {
      "id": "input-number",
      "name": "InputNumber",
      "access": {
        "kind": "export",
        "name": "InputNumber",
        "package": "moraine"
      },
      "description": "Props for the InputNumber component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "align",
          "optional": true,
          "type": {
            "text": "'center' | 'start'"
          }
        },
        {
          "name": "autofocus",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to automatically focus the input on mount.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "autofocusDelay",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Delay in milliseconds before focusing the input.",
          "default": {
            "kind": "literal",
            "value": 0
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "decrement",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to show the decrement button.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "decrementDisabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the decrement button is disabled."
        },
        {
          "name": "decrementIcon",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon for the decrement button.",
          "default": {
            "kind": "expression",
            "text": "orientation === 'vertical' ? 'icon-chevron-down' : 'icon-minus'"
          }
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": {
            "text": "string | number"
          },
          "description": "Default displayed value for uncontrolled usage."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "form",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "The ID of an external form that owns the native spinbutton."
        },
        {
          "name": "holdRepeat",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether press-and-hold should trigger repeated value changes.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "The ID of the input element."
        },
        {
          "name": "increment",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to show the increment button.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "incrementDisabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the increment button is disabled."
        },
        {
          "name": "incrementIcon",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon for the increment button.",
          "default": {
            "kind": "expression",
            "text": "orientation === 'vertical' ? 'icon-chevron-up' : 'icon-plus'"
          }
        },
        {
          "name": "inputRef",
          "optional": true,
          "type": {
            "text": "Ref<HTMLInputElement>"
          },
          "description": "Optional inner input element ref."
        },
        {
          "name": "largeStep",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "The step size used for PageUp/PageDown.",
          "default": {
            "kind": "expression",
            "text": "step * 10"
          }
        },
        {
          "name": "locale",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Locale for number formatting and parsing.\nUses browser default if not specified."
        },
        {
          "name": "maxValue",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Maximum allowed numeric value."
        },
        {
          "name": "minValue",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Minimum allowed numeric value."
        },
        {
          "name": "name",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "The name of the input element, used for form submission."
        },
        {
          "name": "onBlur",
          "optional": true,
          "type": {
            "text": "JSX.FocusEventHandlerUnion<HTMLInputElement, FocusEvent>"
          },
          "description": "Callback when the input loses focus."
        },
        {
          "name": "onChange",
          "optional": true,
          "type": {
            "text": "(value: string) => void"
          },
          "description": "Callback when the formatted string value changes."
        },
        {
          "name": "onDecrementClick",
          "optional": true,
          "type": {
            "text": "JSX.EventHandlerUnion<HTMLButtonElement, MouseEvent>"
          },
          "description": "Callback when the decrement button is clicked."
        },
        {
          "name": "onFocus",
          "optional": true,
          "type": {
            "text": "JSX.FocusEventHandlerUnion<HTMLInputElement, FocusEvent>"
          },
          "description": "Callback when the input gains focus."
        },
        {
          "name": "onIncrementClick",
          "optional": true,
          "type": {
            "text": "JSX.EventHandlerUnion<HTMLButtonElement, MouseEvent>"
          },
          "description": "Callback when the increment button is clicked."
        },
        {
          "name": "onRawValueChange",
          "optional": true,
          "type": {
            "text": "(value: number) => void"
          },
          "description": "Callback when the numeric value changes."
        },
        {
          "name": "orientation",
          "optional": true,
          "type": {
            "text": "'horizontal' | 'vertical'"
          },
          "default": {
            "kind": "literal",
            "value": "horizontal"
          }
        },
        {
          "name": "placeholder",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Placeholder text for the input."
        },
        {
          "name": "rawValue",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Controlled numeric value. Takes precedence over `value`."
        },
        {
          "name": "readOnly",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is read-only.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "repeatDelayMs",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Delay in milliseconds before repeated value changes start.",
          "default": {
            "kind": "literal",
            "value": 500
          }
        },
        {
          "name": "repeatIntervalMs",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Interval in milliseconds between repeated value changes.",
          "default": {
            "kind": "literal",
            "value": 80
          }
        },
        {
          "name": "repeatPointerTypes",
          "optional": true,
          "type": {
            "text": "'all' | PointerType"
          },
          "description": "Pointer types that can trigger press-and-hold repeat.",
          "default": {
            "kind": "literal",
            "value": "all"
          }
        },
        {
          "name": "repeatThrottleMs",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "Minimum elapsed time in milliseconds between repeat triggers.",
          "default": {
            "kind": "literal",
            "value": 0
          }
        },
        {
          "name": "required",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the input is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "step",
          "optional": true,
          "type": {
            "text": "number"
          },
          "description": "The increment/decrement step size.",
          "default": {
            "kind": "literal",
            "value": 1
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "value",
          "optional": true,
          "type": {
            "text": "string | number"
          },
          "description": "Controlled displayed value."
        },
        {
          "name": "variant",
          "optional": true,
          "type": {
            "text": "'outline' | 'subtle' | 'ghost' | 'none'"
          },
          "default": {
            "kind": "literal",
            "value": "outline"
          }
        },
        {
          "name": "wheel",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether mouse wheel changes the value while the input is focused.",
          "default": {
            "kind": "literal",
            "value": false
          }
        }
      ]
    }
  ],
  "slots": [
    "root",
    "input",
    "increment",
    "decrement",
    "controls"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-disabled",
        "data-invalid",
        "data-readonly",
        "data-required"
      ]
    },
    {
      "target": "input",
      "attributes": [
        "data-auto-align",
        "data-disabled",
        "data-invalid",
        "data-readonly",
        "data-required"
      ]
    },
    {
      "target": "increment",
      "attributes": [
        "data-active",
        "data-disabled"
      ]
    },
    {
      "target": "decrement",
      "attributes": [
        "data-active",
        "data-disabled"
      ]
    }
  ],
  "cssVariables": []
}
