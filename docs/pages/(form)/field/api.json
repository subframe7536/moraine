{
  "key": "field",
  "name": "Field",
  "category": "forms",
  "description": "Props for the Field component.",
  "kind": "single",
  "parts": [
    {
      "id": "field",
      "name": "Field",
      "access": {
        "kind": "export",
        "name": "Field",
        "package": "moraine"
      },
      "description": "Props for the Field component.",
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'div'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'div'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": "T"
          },
          "description": "The HTML element or component to render as.",
          "default": {
            "kind": "literal",
            "value": "div"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "ComponentOrElement<RenderProps>"
          },
          "description": "Children of the field, can be a render function."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "description",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Description text shown below the label."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether controls inherit a disabled state."
        },
        {
          "name": "error",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Custom error message or force error state."
        },
        {
          "name": "help",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Help text shown below the control when no error is present."
        },
        {
          "name": "hint",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Hint text shown near the label."
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier for the field."
        },
        {
          "name": "label",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Label for the field."
        },
        {
          "name": "name",
          "optional": true,
          "type": {
            "text": "Name"
          },
          "description": "Optional standalone field name."
        },
        {
          "name": "orientation",
          "optional": true,
          "type": {
            "text": "'vertical' | 'horizontal'"
          },
          "default": {
            "kind": "literal",
            "value": "vertical"
          }
        },
        {
          "name": "readOnly",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether controls inherit a read-only state."
        },
        {
          "name": "required",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the field is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        }
      ]
    }
  ],
  "slots": [
    "root",
    "wrapper",
    "labelWrapper",
    "label",
    "container",
    "description",
    "error",
    "hint",
    "help"
  ],
  "dataAttributes": [
    {
      "target": "label",
      "attributes": [
        "data-required"
      ]
    },
    {
      "target": "container",
      "attributes": [
        "data-has-text"
      ]
    }
  ],
  "cssVariables": []
}
