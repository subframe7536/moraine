{
  "key": "radio-group",
  "name": "RadioGroup",
  "description": "Props for the RadioGroup component.",
  "kind": "single",
  "parts": [
    {
      "id": "radio-group",
      "name": "RadioGroup",
      "access": {
        "kind": "export",
        "name": "RadioGroup"
      },
      "description": "Props for the RadioGroup component.",
      "defaultElement": "div",
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": "string",
          "description": "The default value of the input (uncontrolled)."
        },
        {
          "name": "disabled",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": "string",
          "description": "The ID of the input element."
        },
        {
          "name": "indicator",
          "optional": true,
          "type": "'start' | 'end' | 'hidden'",
          "description": "Placement of the selection indicator.",
          "default": {
            "kind": "literal",
            "value": "start"
          }
        },
        {
          "name": "items",
          "optional": true,
          "type": "(string | Item)[]",
          "description": "Array of items to render in the group."
        },
        {
          "name": "loop",
          "optional": true,
          "type": "boolean",
          "description": "Whether keyboard navigation loops around when reaching the ends.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "name",
          "optional": true,
          "type": "string",
          "description": "The name of the input element, used for form submission."
        },
        {
          "name": "onChange",
          "optional": true,
          "type": "(value: string) => void",
          "description": "Callback when the selected value changes."
        },
        {
          "name": "orientation",
          "optional": true,
          "type": "'horizontal' | 'vertical'",
          "description": "The orientation of the radio group.",
          "default": {
            "kind": "literal",
            "value": "vertical"
          }
        },
        {
          "name": "readOnly",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is read-only.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "required",
          "optional": true,
          "type": "boolean",
          "description": "Whether the input is required.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "description": "Visual size of the component.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "value",
          "optional": true,
          "type": "string",
          "description": "The current value of the input (controlled)."
        },
        {
          "name": "variant",
          "optional": true,
          "type": "'card' | 'table' | 'list'",
          "description": "Visual treatment of the component.",
          "default": {
            "kind": "literal",
            "value": "list"
          }
        }
      ]
    }
  ],
  "item": {
    "description": "A radio item object.",
    "props": [
      {
        "name": "description",
        "optional": true,
        "type": "JSX.Element",
        "description": "Description for the radio item."
      },
      {
        "name": "disabled",
        "optional": true,
        "type": "boolean",
        "description": "Whether the item is disabled."
      },
      {
        "name": "label",
        "optional": true,
        "type": "JSX.Element",
        "description": "Label for the radio item."
      },
      {
        "name": "value",
        "optional": true,
        "type": "string",
        "description": "Value of the radio item."
      }
    ]
  },
  "slots": [
    "root",
    "item",
    "control",
    "container",
    "indicator",
    "wrapper",
    "label",
    "description"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-disabled",
        "data-invalid",
        "data-readonly",
        "data-required"
      ]
    },
    {
      "target": "item",
      "attributes": [
        "data-checked",
        "data-disabled"
      ]
    },
    {
      "target": "control",
      "attributes": [
        "data-checked",
        "data-disabled",
        "data-invalid",
        "data-readonly",
        "data-required"
      ]
    },
    {
      "target": "indicator",
      "attributes": [
        "data-checked"
      ]
    }
  ]
}
