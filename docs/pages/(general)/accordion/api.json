{
  "key": "accordion",
  "name": "Accordion",
  "category": "elements",
  "description": "Props for the Accordion component.",
  "kind": "single",
  "parts": [
    {
      "id": "accordion",
      "name": "Accordion",
      "access": {
        "kind": "export",
        "name": "Accordion",
        "package": "moraine"
      },
      "description": "Props for the Accordion component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "collapsible",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the last expanded item can be collapsed.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "defaultValue",
          "optional": true,
          "type": {
            "text": "string[]"
          },
          "description": "Default list of expanded item values for uncontrolled usage.",
          "default": {
            "kind": "expression",
            "text": "[]"
          }
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the entire accordion is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier for the accordion root element."
        },
        {
          "name": "items",
          "optional": true,
          "type": {
            "text": "Item[]"
          },
          "description": "Array of accordion items to render."
        },
        {
          "name": "loop",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether arrow-key focus wraps from the last trigger to the first and vice versa.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "multiple",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether multiple accordion items can be expanded at the same time.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "onChange",
          "optional": true,
          "type": {
            "text": "(value: string[]) => void"
          },
          "description": "Callback when the expanded item values change."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "trailing",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Trailing icon name for all accordion items.",
          "default": {
            "kind": "literal",
            "value": "icon-chevron-down"
          }
        },
        {
          "name": "unmountOnHide",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to unmount accordion content when hidden.",
          "default": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "name": "value",
          "optional": true,
          "type": {
            "text": "string[]"
          },
          "description": "Controlled list of expanded item values."
        }
      ]
    }
  ],
  "item": {
    "name": "Item",
    "props": [
      {
        "name": "class",
        "optional": true,
        "type": {
          "text": "SlotClassValue"
        },
        "description": "Optional class applied to the item element."
      },
      {
        "name": "content",
        "optional": true,
        "type": {
          "text": "JSX.Element"
        },
        "description": "Content to display when the accordion item is expanded."
      },
      {
        "name": "disabled",
        "optional": true,
        "type": {
          "text": "boolean"
        },
        "description": "Whether the accordion item is disabled.",
        "default": {
          "kind": "literal",
          "value": false
        }
      },
      {
        "name": "label",
        "optional": true,
        "type": {
          "text": "JSX.Element"
        },
        "description": "Header label for the accordion item."
      },
      {
        "name": "leading",
        "optional": true,
        "type": {
          "text": "IconT.Name"
        },
        "description": "Leading icon name for the accordion item."
      },
      {
        "name": "value",
        "optional": true,
        "type": {
          "text": "string"
        },
        "description": "Unique value for the accordion item."
      }
    ]
  },
  "slots": [
    "root",
    "item",
    "header",
    "trigger",
    "leading",
    "label",
    "trailing",
    "content",
    "contentInner"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-disabled"
      ]
    },
    {
      "target": "item",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded"
      ]
    },
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded"
      ]
    }
  ],
  "cssVariables": [
    {
      "target": "content",
      "variables": [
        "--mo-collapsible-content-height"
      ]
    }
  ]
}
