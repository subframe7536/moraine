{
  "key": "avatar",
  "name": "Avatar",
  "category": "elements",
  "description": "Props for the Avatar component.",
  "kind": "single",
  "parts": [
    {
      "id": "avatar",
      "name": "Avatar",
      "access": {
        "kind": "export",
        "name": "Avatar",
        "package": "moraine"
      },
      "description": "Props for the Avatar component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "span",
        "polymorphic": false
      },
      "props": [
        {
          "name": "alt",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Accessible alt text for the avatar."
        },
        {
          "name": "badge",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon name for the badge."
        },
        {
          "name": "badgePosition",
          "optional": true,
          "type": {
            "text": "'top-left' | 'top-right' | 'bottom-left' | 'bottom-right'"
          },
          "default": {
            "kind": "literal",
            "value": "bottom-right"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "fallback",
          "optional": true,
          "type": {
            "text": "IconT.Name"
          },
          "description": "Icon name to show as fallback."
        },
        {
          "name": "onStatusChange",
          "optional": true,
          "type": {
            "text": "(status: Status) => void"
          },
          "description": "Callback when the loading status of the avatar changes."
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "src",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Source URL for the avatar image."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "text",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Initial text to show if image fails or is missing."
        }
      ]
    }
  ],
  "slots": [
    "root",
    "image",
    "fallback",
    "fallbackIcon",
    "badge"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-status"
      ]
    },
    {
      "target": "image",
      "attributes": [
        "data-status"
      ]
    },
    {
      "target": "fallback",
      "attributes": [
        "data-status"
      ]
    }
  ],
  "cssVariables": []
}
