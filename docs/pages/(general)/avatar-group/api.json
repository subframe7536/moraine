{
  "key": "avatar-group",
  "name": "AvatarGroup",
  "category": "elements",
  "description": "Props for the AvatarGroup component.",
  "kind": "single",
  "parts": [
    {
      "id": "avatar-group",
      "name": "AvatarGroup",
      "access": {
        "kind": "export",
        "name": "AvatarGroup",
        "package": "moraine"
      },
      "description": "Props for the AvatarGroup component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "items",
          "optional": true,
          "type": {
            "text": "Item[]"
          },
          "description": "Array of avatars to render in the group.",
          "default": {
            "kind": "expression",
            "text": "[]"
          }
        },
        {
          "name": "max",
          "optional": true,
          "type": {
            "text": "number | string"
          },
          "description": "Maximum number of avatars to show."
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        }
      ]
    }
  ],
  "item": {
    "name": "Item",
    "props": [
      {
        "name": "alt",
        "optional": true,
        "type": {
          "text": "string"
        },
        "description": "Accessible alt text for the avatar."
      },
      {
        "name": "badge",
        "optional": true,
        "type": {
          "text": "IconT.Name"
        },
        "description": "Icon name for the badge."
      },
      {
        "name": "badgePosition",
        "optional": true,
        "type": {
          "text": "NonNullable<Variant['badgePosition']>"
        },
        "description": "Position of the badge.",
        "default": {
          "kind": "literal",
          "value": "bottom-right"
        }
      },
      {
        "name": "fallback",
        "optional": true,
        "type": {
          "text": "IconT.Name"
        },
        "description": "Icon name to show as fallback."
      },
      {
        "name": "onStatusChange",
        "optional": true,
        "type": {
          "text": "(status: Status) => void"
        },
        "description": "Callback when the loading status of the avatar changes."
      },
      {
        "name": "src",
        "optional": true,
        "type": {
          "text": "string"
        },
        "description": "Source URL for the avatar image."
      },
      {
        "name": "text",
        "optional": true,
        "type": {
          "text": "string"
        },
        "description": "Initial text to show if image fails or is missing."
      }
    ]
  },
  "slots": [
    "root",
    "item",
    "count",
    "image",
    "fallback",
    "fallbackIcon",
    "badge"
  ],
  "dataAttributes": [
    {
      "target": "item",
      "attributes": [
        "data-status"
      ]
    },
    {
      "target": "image",
      "attributes": [
        "data-status"
      ]
    },
    {
      "target": "fallback",
      "attributes": [
        "data-status"
      ]
    }
  ],
  "cssVariables": []
}
