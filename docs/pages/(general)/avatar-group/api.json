{
  "key": "avatar-group",
  "name": "AvatarGroup",
  "description": "Props for the AvatarGroup component.",
  "kind": "single",
  "parts": [
    {
      "id": "avatar-group",
      "name": "AvatarGroup",
      "access": {
        "kind": "export",
        "name": "AvatarGroup"
      },
      "description": "Props for the AvatarGroup component.",
      "defaultElement": "div",
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "items",
          "optional": true,
          "type": "Item[]",
          "description": "Array of avatars to render in the group.",
          "default": {
            "kind": "expression",
            "text": "[]"
          }
        },
        {
          "name": "max",
          "optional": true,
          "type": "number | string",
          "description": "Maximum number of avatars to show."
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        }
      ]
    }
  ],
  "item": {
    "props": [
      {
        "name": "alt",
        "optional": true,
        "type": "string",
        "description": "Accessible alt text for the avatar."
      },
      {
        "name": "badge",
        "optional": true,
        "type": "IconT.Name",
        "description": "Icon name for the badge."
      },
      {
        "name": "badgePosition",
        "optional": true,
        "type": "NonNullable<Variant['badgePosition']>",
        "description": "Position of the badge.",
        "default": {
          "kind": "literal",
          "value": "bottom-right"
        }
      },
      {
        "name": "fallback",
        "optional": true,
        "type": "IconT.Name",
        "description": "Icon name to show as fallback."
      },
      {
        "name": "onStatusChange",
        "optional": true,
        "type": "(status: Status) => void",
        "description": "Callback when the loading status of the avatar changes."
      },
      {
        "name": "src",
        "optional": true,
        "type": "string",
        "description": "Source URL for the avatar image."
      },
      {
        "name": "text",
        "optional": true,
        "type": "string",
        "description": "Initial text to show if image fails or is missing."
      }
    ]
  },
  "slots": [
    "root",
    "item",
    "count",
    "image",
    "fallback",
    "fallbackIcon",
    "badge"
  ],
  "dataAttributes": [
    {
      "target": "item",
      "attributes": [
        "data-status"
      ]
    },
    {
      "target": "image",
      "attributes": [
        "data-status"
      ]
    },
    {
      "target": "fallback",
      "attributes": [
        "data-status"
      ]
    }
  ]
}
