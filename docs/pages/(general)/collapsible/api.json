{
  "key": "collapsible",
  "name": "Collapsible",
  "category": "elements",
  "description": "Props for the Collapsible component.",
  "kind": "composite",
  "parts": [
    {
      "id": "collapsible",
      "name": "Collapsible",
      "access": {
        "kind": "export",
        "name": "Collapsible",
        "package": "moraine"
      },
      "description": "Props for the Collapsible component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Content to render inside the collapsible."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "defaultOpen",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the collapsible is open by default (uncontrolled).",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "disabled",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the collapsible is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier for the collapsible root element."
        },
        {
          "name": "onOpenChange",
          "optional": true,
          "type": {
            "text": "(open: boolean) => void"
          },
          "description": "Callback when the open state changes."
        },
        {
          "name": "open",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the collapsible is open (controlled)."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "transition",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to keep content mounted until its height transition completes.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "unmountOnHide",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to unmount collapsible content when closed.",
          "default": {
            "kind": "literal",
            "value": true
          }
        }
      ]
    },
    {
      "id": "collapsible-trigger",
      "name": "Collapsible.Trigger",
      "access": {
        "kind": "attached",
        "root": "Collapsible",
        "member": "Trigger"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "button",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'button'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": "T"
          },
          "default": {
            "kind": "literal",
            "value": "button"
          },
          "description": "Element or component to render as."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "collapsible-content",
      "name": "Collapsible.Content",
      "access": {
        "kind": "attached",
        "root": "Collapsible",
        "member": "Content"
      },
      "generics": [
        {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'div'"
        }
      ],
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "asProp": "as",
        "polymorphic": {
          "name": "T",
          "constraint": "ValidComponent",
          "default": "'div'"
        }
      },
      "props": [
        {
          "name": "as",
          "optional": true,
          "type": {
            "text": "T"
          },
          "description": "Element or component to render inner content as.",
          "default": {
            "kind": "literal",
            "value": "div"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Content to render."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "forceMount",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Force mounting the content in the DOM even when closed.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "unmountOnHide",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to unmount content when closed.",
          "default": {
            "kind": "literal",
            "value": true
          }
        }
      ]
    }
  ],
  "slots": [
    "root",
    "trigger",
    "content"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-closed",
        "data-expanded"
      ]
    },
    {
      "target": "trigger",
      "attributes": [
        "data-closed",
        "data-disabled",
        "data-expanded"
      ]
    },
    {
      "target": "content",
      "attributes": [
        "data-closed",
        "data-expanded",
        "data-transition"
      ]
    }
  ]
}
