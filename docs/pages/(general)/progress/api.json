{
  "key": "progress",
  "name": "Progress",
  "category": "elements",
  "kind": "single",
  "parts": [
    {
      "id": "progress",
      "name": "Progress",
      "access": {
        "kind": "export",
        "name": "Progress",
        "package": "moraine"
      },
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "animation",
          "optional": true,
          "type": {
            "text": "'carousel' | 'reverse' | 'swing' | 'elastic'"
          },
          "default": {
            "kind": "literal",
            "value": "carousel"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "getValueLabel",
          "optional": true,
          "type": {
            "text": "(params: { value: number; min: number; max: number }) => string"
          },
          "description": "Callback to get a localized label for the current value."
        },
        {
          "name": "max",
          "optional": true,
          "type": {
            "text": "number | string[]"
          },
          "description": "The maximum value of the progress bar, or an array of step labels.",
          "default": {
            "kind": "literal",
            "value": 100
          }
        },
        {
          "name": "orientation",
          "optional": true,
          "type": {
            "text": "'horizontal' | 'vertical'"
          },
          "default": {
            "kind": "literal",
            "value": "horizontal"
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": {
            "text": "'sm' | 'md' | 'lg'"
          },
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "status",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether to show the status label.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "statusRender",
          "optional": true,
          "type": {
            "text": "ComponentOrElement<StatusRenderProps>"
          },
          "description": "Custom render function for the status label."
        },
        {
          "name": "stepRender",
          "optional": true,
          "type": {
            "text": "ComponentOrElement<StepRenderProps>"
          },
          "description": "Custom render function for each step when `max` is an array."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "value",
          "optional": true,
          "type": {
            "text": "number | null"
          },
          "description": "The current value of the progress bar. If null/undefined, it is indeterminate.",
          "default": {
            "kind": "literal",
            "value": null
          }
        }
      ]
    }
  ],
  "slots": [
    "root",
    "status",
    "track",
    "indicator",
    "steps",
    "step"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-indeterminate",
        "data-progress"
      ]
    },
    {
      "target": "indicator",
      "attributes": [
        "data-indeterminate",
        "data-progress"
      ]
    },
    {
      "target": "step",
      "attributes": [
        "data-state"
      ]
    }
  ]
}
