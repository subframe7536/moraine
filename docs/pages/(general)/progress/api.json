{
  "key": "progress",
  "name": "Progress",
  "kind": "single",
  "parts": [
    {
      "id": "progress",
      "name": "Progress",
      "access": {
        "kind": "export",
        "name": "Progress"
      },
      "defaultElement": "div",
      "props": [
        {
          "name": "animation",
          "optional": true,
          "type": "'carousel' | 'reverse' | 'swing' | 'elastic'",
          "description": "Visual animation of the component.",
          "default": {
            "kind": "literal",
            "value": "carousel"
          }
        },
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "getValueLabel",
          "optional": true,
          "type": "(params: { value: number; min: number; max: number }) => string",
          "description": "Callback to get a localized label for the current value."
        },
        {
          "name": "max",
          "optional": true,
          "type": "number | string[]",
          "description": "The maximum value of the progress bar, or an array of step labels.",
          "default": {
            "kind": "literal",
            "value": 100
          }
        },
        {
          "name": "orientation",
          "optional": true,
          "type": "'horizontal' | 'vertical'",
          "description": "Visual layout direction.",
          "default": {
            "kind": "literal",
            "value": "horizontal"
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "description": "Visual size of the component.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "status",
          "optional": true,
          "type": "boolean",
          "description": "Whether to show the status label.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "statusRender",
          "optional": true,
          "type": "ComponentOrElement<StatusRenderProps>",
          "description": "Custom render function for the status label."
        },
        {
          "name": "stepRender",
          "optional": true,
          "type": "ComponentOrElement<StepRenderProps>",
          "description": "Custom render function for each step when `max` is an array."
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "value",
          "optional": true,
          "type": "number | null",
          "description": "The current value of the progress bar. If null/undefined, it is indeterminate.",
          "default": {
            "kind": "literal",
            "value": null
          }
        }
      ]
    }
  ],
  "slots": [
    "root",
    "status",
    "track",
    "indicator",
    "steps",
    "step"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-indeterminate",
        "data-progress"
      ]
    },
    {
      "target": "indicator",
      "attributes": [
        "data-indeterminate",
        "data-progress"
      ]
    },
    {
      "target": "step",
      "attributes": [
        "data-state"
      ]
    }
  ]
}
