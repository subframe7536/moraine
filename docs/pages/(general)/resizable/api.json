{
  "key": "resizable",
  "name": "Resizable",
  "category": "elements",
  "description": "Props for the Resizable component.",
  "kind": "composite",
  "parts": [
    {
      "id": "resizable",
      "name": "Resizable",
      "access": {
        "kind": "export",
        "name": "Resizable",
        "package": "moraine"
      },
      "description": "Props for the Resizable component.",
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Ordered `Resizable.Panel` and `Resizable.Handle` children."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": {
            "text": "Classes"
          },
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "disable",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether the resizable component is disabled.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "id",
          "optional": true,
          "type": {
            "text": "string"
          },
          "description": "Unique identifier for the resizable root."
        },
        {
          "name": "keyboardDelta",
          "optional": true,
          "type": {
            "text": "ResizableSize"
          },
          "description": "The amount to resize when using keyboard shortcuts.",
          "default": {
            "kind": "literal",
            "value": "10%"
          }
        },
        {
          "name": "onHandleKeyDown",
          "optional": true,
          "type": {
            "text": "(context: { event: KeyboardEvent handleIndex: number sizes: number[] }) => void"
          },
          "description": "Callback when a key is pressed on a handle."
        },
        {
          "name": "onResize",
          "optional": true,
          "type": {
            "text": "(sizes: number[]) => void"
          },
          "description": "Callback when any panel is resized."
        },
        {
          "name": "onResizeEnd",
          "optional": true,
          "type": {
            "text": "(sizes: number[]) => void"
          },
          "description": "Callback when a resize operation ends."
        },
        {
          "name": "onResizeStart",
          "optional": true,
          "type": {
            "text": "(sizes: number[]) => void"
          },
          "description": "Callback when a resize operation starts."
        },
        {
          "name": "orientation",
          "optional": true,
          "type": {
            "text": "'horizontal' | 'vertical'"
          },
          "default": {
            "kind": "literal",
            "value": "horizontal"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": {
            "text": "Styles"
          },
          "description": "Family slot style defaults for this instance."
        }
      ]
    },
    {
      "id": "resizable-panel",
      "name": "Resizable.Panel",
      "access": {
        "kind": "attached",
        "root": "Resizable",
        "member": "Panel"
      },
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "JSX.Element"
          },
          "description": "Content rendered inside the panel."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    },
    {
      "id": "resizable-handle",
      "name": "Resizable.Handle",
      "access": {
        "kind": "attached",
        "root": "Resizable",
        "member": "Handle"
      },
      "rendering": {
        "rendersDom": true,
        "defaultElement": "div",
        "polymorphic": false
      },
      "props": [
        {
          "name": "action",
          "optional": true,
          "type": {
            "text": "'resize' | 'collapse'"
          },
          "description": "Handle interaction behavior.",
          "default": {
            "kind": "literal",
            "value": "resize"
          }
        },
        {
          "name": "children",
          "optional": true,
          "type": {
            "text": "ComponentOrElement<HandleRenderProps>"
          },
          "description": "Custom grip content, or a component receiving the live handle state."
        },
        {
          "name": "class",
          "optional": true,
          "type": {
            "text": "SlotClassValue"
          },
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "intersection",
          "optional": true,
          "type": {
            "text": "boolean"
          },
          "description": "Whether this handle participates in intersection resizing.",
          "default": {
            "kind": "literal",
            "value": false
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": {
            "text": "SlotStyleValue"
          },
          "description": "Style applied to the component root or trigger element."
        }
      ]
    }
  ],
  "slots": [
    "root",
    "panel",
    "divider",
    "handle",
    "crossTarget"
  ],
  "dataAttributes": [
    {
      "target": "root",
      "attributes": [
        "data-resizable-root"
      ]
    },
    {
      "target": "panel",
      "attributes": [
        "data-collapsed",
        "data-expanded",
        "data-resizing",
        "data-transitioning"
      ]
    },
    {
      "target": "divider",
      "attributes": [
        "data-active",
        "data-cross",
        "data-dragging"
      ]
    },
    {
      "target": "handle",
      "attributes": [
        "data-collapse"
      ]
    },
    {
      "target": "crossTarget",
      "attributes": [
        "data-resizable-handle-end-target",
        "data-resizable-handle-start-target"
      ]
    }
  ],
  "cssVariables": []
}
