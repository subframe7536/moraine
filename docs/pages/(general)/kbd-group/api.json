{
  "key": "kbd-group",
  "name": "KbdGroup",
  "description": "Props for the KbdGroup component.",
  "kind": "single",
  "parts": [
    {
      "id": "kbd-group",
      "name": "KbdGroup",
      "access": {
        "kind": "export",
        "name": "KbdGroup"
      },
      "description": "Props for the KbdGroup component.",
      "defaultElement": "kbd",
      "props": [
        {
          "name": "class",
          "optional": true,
          "type": "SlotClassValue",
          "description": "Class applied to the component root or trigger element."
        },
        {
          "name": "classes",
          "optional": true,
          "type": "Classes",
          "description": "Family slot class defaults for this instance."
        },
        {
          "name": "items",
          "optional": false,
          "type": "Item[]",
          "description": "Keyboard keys displayed as one simultaneous shortcut."
        },
        {
          "name": "separator",
          "optional": true,
          "type": "JSX.Element",
          "description": "Inline content rendered between keys.",
          "default": {
            "kind": "literal",
            "value": "+"
          }
        },
        {
          "name": "size",
          "optional": true,
          "type": "'sm' | 'md' | 'lg'",
          "description": "Visual size of the component.",
          "default": {
            "kind": "literal",
            "value": "md"
          }
        },
        {
          "name": "style",
          "optional": true,
          "type": "SlotStyleValue",
          "description": "Style applied to the component root or trigger element."
        },
        {
          "name": "styles",
          "optional": true,
          "type": "Styles",
          "description": "Family slot style defaults for this instance."
        },
        {
          "name": "variant",
          "optional": true,
          "type": "'default' | 'outline' | 'invert'",
          "description": "Visual style variant applied to rendered shortcut keys.",
          "default": {
            "kind": "literal",
            "value": "default"
          }
        }
      ]
    }
  ],
  "item": {
    "props": [
      {
        "name": "label",
        "optional": true,
        "type": "string",
        "description": "Accessible label for assistive technology."
      },
      {
        "name": "slotName",
        "optional": true,
        "type": "string",
        "description": "Data slot used by the rendered keycap."
      },
      {
        "name": "symbol",
        "optional": true,
        "type": "boolean",
        "description": "Whether to resolve known key aliases to symbols.",
        "default": {
          "kind": "literal",
          "value": true
        }
      },
      {
        "name": "value",
        "optional": false,
        "type": "Key",
        "description": "Value displayed by the keycap or resolved through the static key aliases."
      }
    ]
  },
  "slots": [
    "root",
    "item"
  ],
  "dataAttributes": []
}
